---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = 'Levi Henry Group',
  description = '',
  noindex = false,
  image = '/assets/brand/og-default.jpg',
  jsonld,
} = Astro.props;

const SITE = Astro.site ?? new URL('https://thelevihenry.com');
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '') || '/', SITE).href.replace(/\/$/, '') || SITE.href;
const ogImage = new URL(image, SITE).href;

// Site-wide structured data: who we are + the site itself. Helps Google rich
// results and gives AI assistants a clean, factual entity to cite.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Levi Henry Group',
  url: SITE.href,
  logo: new URL('/assets/brand/logo-icon.png', SITE).href,
  image: ogImage,
  description:
    'Consulting, education, and technology company helping individuals build high-income skills and businesses build the systems that produce revenue.',
  email: 'levi@thelevihenry.com',
  founder: { '@type': 'Person', name: 'Levi Henry' },
  areaServed: 'North America',
  sameAs: ['https://linktr.ee/thelevihenry'],
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Levi Henry Group',
  url: SITE.href,
};
const structured = [orgLd, siteLd, ...(jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Levi Henry Group" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/assets/brand/favicon-32.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f1219" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} is:inline />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-0 focus:top-0 focus:z-[200] focus:bg-navy focus:px-5 focus:py-3 focus:text-white"
      >Skip to content</a
    >
    <slot />

    <script is:inline>
      // ---- footer year ----
      document.querySelectorAll("[data-year]").forEach(function (el) {
        el.textContent = new Date().getFullYear();
      });

      // ---- mobile menu ----
      var toggle = document.querySelector("[data-nav-toggle]");
      var panel = document.querySelector("[data-nav-panel]");
      if (toggle && panel) {
        toggle.addEventListener("click", function () {
          var open = panel.hasAttribute("hidden");
          if (open) {
            panel.removeAttribute("hidden");
          } else {
            panel.setAttribute("hidden", "");
          }
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
          toggle.textContent = open ? "Close" : "Menu";
        });
      }

      // ---- scroll reveal (Web Animations API, with subtle sibling stagger) ----
      document.documentElement.classList.add("js");
      var revealables = document.querySelectorAll("[data-reveal]");
      var reduce =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function staggerDelay(el) {
        var parent = el.parentElement;
        if (!parent) return 0;
        var group = [];
        for (var i = 0; i < parent.children.length; i++) {
          var c = parent.children[i];
          if (c.hasAttribute && c.hasAttribute("data-reveal")) group.push(c);
        }
        var idx = group.indexOf(el);
        return idx > 0 ? Math.min(idx, 5) * 80 : 0;
      }

      function play(el) {
        var delay = staggerDelay(el);
        if (el.animate) {
          el.animate(
            [
              { opacity: 0, transform: "translateY(22px)" },
              { opacity: 1, transform: "translateY(0)" },
            ],
            {
              duration: 450, // mirrors --dur-reveal in global.css
              delay: delay,
              easing: "cubic-bezier(0.23, 1, 0.32, 1)", // mirrors --ease-out
              fill: "both",
            }
          );
        } else {
          el.style.opacity = "1";
        }
      }

      if (!reduce && "IntersectionObserver" in window && revealables.length) {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                play(e.target);
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -8% 0px" }
        );
        revealables.forEach(function (el) {
          io.observe(el);
        });
      } else {
        revealables.forEach(function (el) {
          el.style.opacity = "1";
        });
      }

      // ---- contact form status (after the function redirects back) ----
      var status = document.querySelector("[data-form-status]");
      if (status) {
        var q = window.location.search;
        if (q.indexOf("sent=1") !== -1) {
          status.textContent =
            "Thanks — your message is on its way. We'll get back to you personally.";
          status.style.color = "var(--color-navy)";
        } else if (q.indexOf("err=1") !== -1) {
          status.textContent =
            "Something went wrong sending that. Please email us directly at levi@thelevihenry.com and we'll get right back to you.";
          status.style.color = "var(--color-ink)";
        }
      }
    </script>
  </body>
</html>
