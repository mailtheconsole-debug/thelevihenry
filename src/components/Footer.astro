<footer class="border-t border-white/10 bg-[#0f1219] text-white/70">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 sm:grid-cols-2 md:grid-cols-[1.6fr_1fr_1fr]">
    <div>
      <a href="/" class="inline-flex items-center" aria-label="Levi Henry Group home">
        <img
          src="/assets/brand/logo-horizontal-dark.png"
          alt="Levi Henry Group"
          width="2232"
          height="955"
          class="h-11 w-auto"
          loading="lazy"
        />
      </a>
      <p class="mt-4 max-w-xs text-sm text-white/60">
        Building the people and systems that produce revenue. Consulting, education &amp;
        technology services for individuals and small business owners.
      </p>
    </div>
    <div>
      <h4 class="font-sans text-xs font-semibold uppercase tracking-widest text-brass-soft">Explore</h4>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/about" class="transition hover:text-white">About</a></li>
        <li><a href="/individuals" class="transition hover:text-white">For Individuals</a></li>
        <li><a href="/businesses" class="transition hover:text-white">For Businesses</a></li>
        <li><a href="/founders" class="transition hover:text-white">For Founders</a></li>
        <li><a href="/insights" class="transition hover:text-white">Insights</a></li>
        <li><a href="/contact" class="transition hover:text-white">Contact Us</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-sans text-xs font-semibold uppercase tracking-widest text-brass-soft">Connect</h4>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/book-discovery" class="transition hover:text-white">Book a free discovery call</a></li>
        <li><a href="https://linktr.ee/thelevihenry" target="_blank" rel="noopener" class="transition hover:text-white">Socials &amp; Other links</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-3 px-6 py-5 text-xs text-white/55">
      <span>&copy; <span data-year></span> Levi Henry Group. All rights reserved.</span>
      <span class="flex gap-4">
        <a href="/privacy" class="transition hover:text-white">Privacy Policy</a>
        <a href="/terms" class="transition hover:text-white">Terms of Service</a>
      </span>
    </div>
  </div>
</footer>
