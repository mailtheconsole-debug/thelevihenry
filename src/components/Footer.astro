---
---

<footer class="border-t border-white/10 bg-[#0f1219] text-white/70">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 sm:grid-cols-2 md:grid-cols-[1.6fr_1fr_1fr]">
    <div>
      <a href="/" class="inline-flex items-center" aria-label="Levi Henry Group home">
        <img
          src="/assets/brand/logo-horizontal-dark.png"
          alt="Levi Henry Group"
          width="2232"
          height="955"
          class="h-11 w-auto"
          loading="lazy"
        />
      </a>
      <p class="mt-4 max-w-xs text-sm text-white/60">
        Building the people and systems that produce revenue. Consulting, education &amp;
        technology services for individuals and small business owners.
      </p>
    </div>
    <div>
      <h4 class="font-sans text-xs font-semibold uppercase tracking-widest text-brass-soft">Explore</h4>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/about" class="inline-block py-2.5 transition md:py-1.5 hover:text-white">About</a></li>
        <li><a href="/individuals" class="inline-block py-2.5 transition md:py-1.5 hover:text-white">For Individuals</a></li>
        <li><a href="/businesses" class="inline-block py-2.5 transition md:py-1.5 hover:text-white">For Businesses</a></li>
        <li><a href="/founders" class="inline-block py-2.5 transition md:py-1.5 hover:text-white">For Founders</a></li>
        <li><a href="/programs" class="inline-block py-2.5 transition md:py-1.5 hover:text-white">Programs</a></li>
        <li><a href="/insights" class="inline-block py-2.5 transition md:py-1.5 hover:text-white">Blog</a></li>
        <li><a href="/contact" class="inline-block py-2.5 transition md:py-1.5 hover:text-white">Contact Us</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-sans text-xs font-semibold uppercase tracking-widest text-brass-soft">Connect</h4>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/book-discovery" class="inline-block py-2.5 transition hover:text-white md:py-1.5">Book a free discovery call</a></li>
        <li><a href="https://linktr.ee/thelevihenry" target="_blank" rel="noopener" class="inline-block py-2.5 transition hover:text-white md:py-1.5">Socials &amp; Other links</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-3 px-6 py-5 text-xs text-white/55">
      <span>&copy; <span data-year></span> Levi Henry Group. All rights reserved.</span>
      <span class="flex gap-4">
        <a href="/privacy" class="inline-block py-2.5 transition hover:text-white md:py-1">Privacy Policy</a>
        <a href="/terms" class="inline-block py-2.5 transition hover:text-white md:py-1">Terms of Service</a>
      </span>
    </div>
  </div>
</footer>
