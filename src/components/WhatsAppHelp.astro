---
// A quiet "reach out on WhatsApp" affordance for people with questions or
// doubts before they act. Direct line to Levi, which is what pulled a stalled
// checkout back to a near-close. Reused near the pay/enroll CTAs.
interface Props {
  label?: string;
  class?: string;
}
const {
  label = 'Questions or doubts? Message me on WhatsApp',
  class: className = '',
} = Astro.props;

const WHATSAPP_URL = 'https://wa.link/r7l4s5';
---

<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener"
  class:list={[
    'inline-flex max-w-full items-center justify-center gap-2.5 rounded-full border border-line bg-paper-raised px-5 py-2.5 text-center font-sans text-sm font-semibold leading-snug text-navy shadow-sm shadow-navy/5 transition hover:border-navy/30 hover:text-navy-600',
    className,
  ]}
>
  <svg class="h-5 w-5 shrink-0 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.82 2.42a8.2 8.2 0 0 1 2.42 5.82c0 4.54-3.7 8.24-8.24 8.24h-.01a8.22 8.22 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24Zm-4.73 4.5c-.22 0-.58.08-.88.41-.3.33-1.15 1.13-1.15 2.75s1.18 3.19 1.34 3.41c.17.22 2.3 3.52 5.58 4.8.78.3 1.39.48 1.86.62.78.25 1.49.21 2.05.13.63-.09 1.93-.79 2.2-1.55.27-.76.27-1.42.19-1.55-.08-.14-.3-.22-.63-.38-.33-.17-1.93-.95-2.23-1.06-.3-.11-.52-.17-.74.17-.22.33-.85 1.06-1.04 1.28-.19.22-.38.25-.71.08-.33-.17-1.38-.51-2.63-1.62-.97-.87-1.63-1.94-1.82-2.27-.19-.33-.02-.5.15-.67.15-.15.33-.38.5-.58.16-.19.22-.33.33-.55.11-.22.06-.41-.03-.58-.08-.17-.74-1.8-1.02-2.46-.27-.65-.54-.56-.74-.57-.19-.01-.41-.01-.63-.01Z"/>
  </svg>
  <span>{label}</span>
</a>
