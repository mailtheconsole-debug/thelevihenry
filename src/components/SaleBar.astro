---
// A slim bar at the top of every page while Remote SDR Training is on sale (e.g. Early Black Friday Sale).
// It paints immediately while the sale is on (rendered visible server-side, countdown started from a
// baked end time), so there is no blank gap or pop-in. The live offer from the Academy is still fetched
// and is authoritative: it corrects the price/label/end or hides the bar. The course page has its own,
// bigger sale banner, and the post-purchase page doesn't need one, so the bar stays off those two.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const skip = ['/remote-sdr-training', '/welcome'].includes(path);

// The current sale, known at build time so the bar can render on first paint. The live Academy offer
// (fetched in the script below) overrides these values or hides the bar, and the baked end time also
// lets the client hide the bar on its own once the sale is over, even without a rebuild.
const SALE = { label: 'Early Black Friday Sale', priceNgn: 30000, wasNgn: 60000, endsAt: '2026-11-23T22:59:59Z' };
const pct = Math.round((1 - SALE.priceNgn / SALE.wasNgn) * 100);
const naira = (n: number) => '₦' + n.toLocaleString('en-NG');
const saleOn = Date.now() < new Date(SALE.endsAt).getTime();
---

{!skip && (
  <a data-salebar hidden={!saleOn} data-salebar-ends={SALE.endsAt} href="/remote-sdr-training" class="block bg-ink-black text-white transition hover:bg-navy-deep">
    <span class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-3 gap-y-1 px-6 py-2.5 text-center font-sans text-xs font-semibold sm:text-sm">
      <span class="font-extrabold uppercase tracking-[0.1em] text-beacon" data-salebar-label>{SALE.label}</span>
      <span><span data-salebar-pct>{pct}</span>% off Remote SDR Training: <span class="font-bold text-beacon" data-salebar-price>{naira(SALE.priceNgn)}</span> <span class="ml-1.5 text-white/55 line-through" data-salebar-was>{naira(SALE.wasNgn)}</span></span>
      <span class="tabular-nums text-white/75">Ends in <span class="font-bold text-white" data-salebar-countdown></span></span>
      <span class="font-bold underline underline-offset-4">Get it now &rarr;</span>
    </span>
  </a>
)}

<script>
  const bar = document.querySelector<HTMLElement>('[data-salebar]');
  if (bar) {
    const naira = (n: number) => '₦' + n.toLocaleString('en-NG');
    const left = (ms: number) => {
      const s = Math.max(0, Math.floor(ms / 1000));
      const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
      const pad = (n: number) => String(n).padStart(2, '0');
      return (d ? `${d}d ` : '') + `${pad(h)}h ${pad(m)}m ${pad(sec)}s`;
    };
    const set = (sel: string, text: string) => bar.querySelectorAll<HTMLElement>(sel).forEach((el) => (el.textContent = text));

    let timer: number | undefined;
    const runCountdown = (end: number) => {
      const tick = () => {
        const ms = end - Date.now();
        if (ms <= 0) { bar.hidden = true; if (timer) window.clearInterval(timer); return; }
        set('[data-salebar-countdown]', left(ms));
      };
      if (timer) window.clearInterval(timer);
      timer = window.setInterval(tick, 1000);
      tick();
    };

    // Paint instantly from the baked end time the server rendered, so the countdown runs with no wait.
    // If the sale is already over (stale build, not yet rebuilt), hide right away.
    const baked = bar.getAttribute('data-salebar-ends');
    if (baked) {
      const bakedEnd = new Date(baked).getTime();
      if (bakedEnd > Date.now()) { runCountdown(bakedEnd); bar.hidden = false; }
      else { bar.hidden = true; }
    }

    // Then confirm against the live offer. This is authoritative: it corrects the price/label/end or
    // hides the bar. A failed fetch leaves the baked state in place, so the bar still shows during a sale.
    fetch('https://learn.thelevihenry.com/api/offers/remote-sdr-training', { cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : null))
      .then((o) => {
        const sale = o && o.sale;
        if (!sale || typeof sale.priceNgn !== 'number' || typeof sale.wasNgn !== 'number') { bar.hidden = true; return; }
        const end = new Date(sale.endsAt).getTime();
        if (!(end > Date.now())) { bar.hidden = true; return; }
        set('[data-salebar-label]', sale.label || 'Sale');
        set('[data-salebar-pct]', String(Math.round((1 - sale.priceNgn / sale.wasNgn) * 100)));
        set('[data-salebar-price]', naira(sale.priceNgn));
        set('[data-salebar-was]', naira(sale.wasNgn));
        runCountdown(end);
        bar.hidden = false;
      })
      .catch(() => {});
  }
</script>
