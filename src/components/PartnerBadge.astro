---
// Partner credentials. Wording follows each partner's guidance (CTG: "Independent
// Partner", never employment). Deliberately not links: visitors stay on this site.
// `bare` drops the top rule and margin, for use inside its own full-width section.
const { bare = false } = Astro.props;
const partners = [
  { logo: '/assets/brand/cloud-tech-gurus.png', name: 'Cloud Tech Gurus', w: 584, h: 170, role: 'Independent Partner', org: 'Cloud Tech Gurus' },
  { logo: '/assets/brand/kastech.png', name: 'Kastech Network', w: 585, h: 175, role: 'Technology Partner', org: 'Kastech Network' },
];
---

<div class:list={['mx-auto max-w-xl text-center', !bare && 'mt-8 border-t border-line pt-6']}>
  <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">Partners</p>
  <div class="mt-5 grid grid-cols-2 gap-4 sm:gap-6">
    {partners.map((p) => (
      <div class="flex flex-col items-center gap-3">
        <img src={p.logo} alt={p.name} width={p.w} height={p.h} loading="lazy" class="h-8 w-auto sm:h-11" />
        <span class="text-balance font-sans text-xs font-semibold uppercase leading-snug tracking-[0.06em] text-ink-soft sm:tracking-[0.14em]">
          {p.role},<br class="hidden sm:block" /> {p.org}
        </span>
      </div>
    ))}
  </div>
</div>
