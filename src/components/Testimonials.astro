---
import { getCollection } from 'astro:content';

const items = (await getCollection('testimonials', (t) => !t.data.draft)).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order ||
    a.data.name.localeCompare(b.data.name)
);

const initials = (name) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();

const arrow =
  'group/arrow flex h-12 w-12 items-center justify-center rounded-full btn-primary text-white transition duration-300 ease-[var(--ease-out)] hover:-translate-y-0.5 disabled:pointer-events-none disabled:opacity-30 disabled:shadow-none';
---

{items.length > 0 && (
  <section class="border-t border-line">
    <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
      <div class="flex items-end justify-between gap-6" data-reveal>
        <div class="max-w-2xl">
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">In their words</p>
          <h2 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-navy sm:text-4xl">What clients say.</h2>
        </div>
        <div class="hidden shrink-0 gap-2 sm:flex">
          <button type="button" data-tprev aria-label="Previous testimonials" class={arrow}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover/arrow:-translate-x-0.5" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
          </button>
          <button type="button" data-tnext aria-label="Next testimonials" class={arrow}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover/arrow:translate-x-0.5" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
          </button>
        </div>
      </div>

      <div
        data-tscroll
        role="region"
        aria-label="Client testimonials"
        tabindex="0"
        class="testi-track mt-10 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth px-1 pb-3 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {items.map((t) => (
          <article class="w-[300px] shrink-0 snap-center sm:w-[340px]">
            {t.data.type === 'video' ? (
              <div class="group/card relative flex h-[480px] flex-col overflow-hidden rounded-2xl bg-navy-deep shadow-xl shadow-navy/25 ring-1 ring-white/10 transition duration-300 ease-[var(--ease-out)] hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-navy/30">
                <div class="relative min-h-0 flex-1">
                  <video class="absolute inset-0 h-full w-full object-cover" preload="none" playsinline poster={t.data.poster} src={t.data.video}></video>
                  <button type="button" class="video-play absolute inset-0 z-[2] flex items-center justify-center bg-gradient-to-t from-navy-deep/45 via-transparent to-transparent transition" aria-label={`Play ${t.data.name}'s testimonial`}>
                    <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/92 shadow-xl ring-1 ring-white/50 backdrop-blur transition duration-300 group-hover/card:scale-110">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="#14273f" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    </span>
                  </button>
                  <span class="pointer-events-none absolute left-4 top-4 z-[2] inline-flex items-center gap-1.5 rounded-full bg-black/35 px-3 py-1 font-sans text-[0.7rem] font-semibold uppercase tracking-wider text-white backdrop-blur-sm">
                    <span class="text-beacon-soft" aria-hidden="true">&#9658;</span> Video
                  </span>
                </div>
                <figcaption class="flex items-center gap-2 px-5 py-4">
                  <span class="font-sans text-sm font-semibold text-white">{t.data.name}</span>
                  {t.data.role && <span class="truncate font-sans text-xs text-white/55">&middot; {t.data.role}</span>}
                </figcaption>
              </div>
            ) : (
              <div class="group/card band-dark relative flex h-[480px] flex-col overflow-hidden rounded-2xl p-6 shadow-xl shadow-navy/25 ring-1 ring-white/10 transition duration-300 ease-[var(--ease-out)] hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-navy/30">
                <div class="beacon-glow"></div>
                <span class="relative font-serif text-5xl leading-[0.8] text-brass-soft" aria-hidden="true">&ldquo;</span>
                <blockquote class="relative mt-2 flex-1 overflow-hidden font-serif text-lg font-medium leading-snug text-white [-webkit-box-orient:vertical] [-webkit-line-clamp:5] [display:-webkit-box]">
                  {t.data.quote}
                </blockquote>
                <figcaption class="relative mt-4 flex items-center gap-3">
                  {t.data.avatar ? (
                    <img src={t.data.avatar} alt={t.data.name} width="44" height="44" loading="lazy" class="h-11 w-11 rounded-full object-cover ring-1 ring-white/20" />
                  ) : (
                    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 font-sans text-sm font-bold text-brass-soft ring-1 ring-white/20">{initials(t.data.name)}</span>
                  )}
                  <span>
                    <span class="block font-sans text-sm font-semibold text-white">{t.data.name}</span>
                    {t.data.role && <span class="block font-sans text-xs text-white/60">{t.data.role}</span>}
                  </span>
                </figcaption>
                {t.data.proof && (
                  <button
                    type="button"
                    class="proof-open relative mt-4 flex w-full items-center gap-3 rounded-lg border border-white/15 bg-white/5 p-2 text-left transition hover:border-white/30 hover:bg-white/10"
                    data-proof={t.data.proof}
                    data-proof-alt={t.data.proofAlt || `Message from ${t.data.name}`}
                  >
                    <img src={t.data.proof} alt="" width="40" height="52" loading="lazy" class="w-10 shrink-0 rounded object-cover object-top ring-1 ring-white/15" style="height:52px" />
                    <span class="min-w-0 flex-1">
                      <span class="block font-sans text-xs font-semibold text-white">See the real message</span>
                      <span class="block font-sans text-[0.7rem] text-white/55">Screenshot &middot; tap to enlarge</span>
                    </span>
                    <svg class="shrink-0 text-white/55" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                  </button>
                )}
              </div>
            )}
          </article>
        ))}
      </div>

      <!-- progress + swipe cue -->
      <div class="mt-7 flex items-center gap-4" data-reveal>
        <div class="h-1 flex-1 overflow-hidden rounded-full bg-line/70">
          <div data-tprogress class="h-full rounded-full bg-navy transition-[width] duration-150 ease-out" style="width:25%"></div>
        </div>
        <span data-thint class="flex shrink-0 items-center gap-1.5 font-sans text-xs font-semibold uppercase tracking-[0.15em] text-navy-600 transition-opacity duration-300">
          Swipe to view more <span class="swipe-arrow" aria-hidden="true">&rarr;</span>
        </span>
      </div>
    </div>
  </section>
)}

<!-- Proof lightbox (shared) -->
<div id="proof-lightbox" style="display:none" class="fixed inset-0 z-[100] items-center justify-center bg-black/85 p-4 backdrop-blur-sm">
  <button type="button" data-proof-close aria-label="Close" class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-2xl leading-none text-white transition hover:bg-white/20">&times;</button>
  <img id="proof-img" src="" alt="" class="max-h-[88vh] w-auto max-w-full rounded-xl shadow-2xl" />
</div>

<script is:inline>
  (function () {
    // Video play overlays.
    document.querySelectorAll('.video-play').forEach((btn) => {
      const video = btn.parentElement.querySelector('video');
      if (!video) return;
      btn.addEventListener('click', () => {
        video.controls = true;
        video.play();
        btn.style.display = 'none';
      });
      video.addEventListener('ended', () => { video.controls = false; btn.style.display = 'flex'; });
    });

    // Proof lightbox.
    const lb = document.getElementById('proof-lightbox');
    const lbImg = document.getElementById('proof-img');
    if (lb && lbImg) {
      const open = (src, alt) => { lbImg.src = src; lbImg.alt = alt || ''; lb.style.display = 'flex'; document.body.style.overflow = 'hidden'; };
      const close = () => { lb.style.display = 'none'; lbImg.src = ''; document.body.style.overflow = ''; };
      document.querySelectorAll('.proof-open').forEach((b) =>
        b.addEventListener('click', () => open(b.getAttribute('data-proof'), b.getAttribute('data-proof-alt')))
      );
      lb.addEventListener('click', (e) => { if (e.target === lb || e.target.hasAttribute('data-proof-close')) close(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && lb.style.display === 'flex') close(); });
    }

    // Slider: arrows, progress bar, swipe hint.
    const scroller = document.querySelector('[data-tscroll]');
    if (!scroller) return;
    const prev = document.querySelector('[data-tprev]');
    const next = document.querySelector('[data-tnext]');
    const progress = document.querySelector('[data-tprogress]');
    const hint = document.querySelector('[data-thint]');
    const step = () => Math.min(scroller.clientWidth * 0.85, 366);
    prev && prev.addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior: 'smooth' }));
    next && next.addEventListener('click', () => scroller.scrollBy({ left: step(), behavior: 'smooth' }));
    const update = () => {
      const maxScroll = scroller.scrollWidth - scroller.clientWidth;
      const scrollable = maxScroll > 8;
      if (prev) prev.disabled = scroller.scrollLeft <= 4;
      if (next) next.disabled = scroller.scrollLeft >= maxScroll - 4;
      if (progress) {
        const pct = scrollable ? ((scroller.scrollLeft + scroller.clientWidth) / scroller.scrollWidth) * 100 : 100;
        progress.style.width = Math.min(100, Math.max(15, pct)) + '%';
      }
      if (hint) hint.style.opacity = scrollable && scroller.scrollLeft < maxScroll - 12 ? '1' : '0';
    };
    scroller.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>
