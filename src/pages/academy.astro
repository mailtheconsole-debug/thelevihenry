---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BandTexture from '../components/BandTexture.astro';
import EnrollButton from '../components/EnrollButton.astro';

const formats = [
  {
    t: 'Bootcamps',
    d: 'Live cohorts. Learn with a group on set dates.',
    color: '#225cc0',
    icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
  {
    t: 'Courses',
    d: 'Self-paced. Learn on your own schedule.',
    color: '#c7892b',
    icon: '<circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/>',
  },
  {
    t: 'One-on-one sessions',
    d: 'Personal coaching built around your goals.',
    color: '#14273f',
    icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  },
];

const sdrIncludes = [
  '116 video lessons, 18 hours, across 8 modules, plus a free Start here training and a bonus session',
  '8 module guides, an interview companion guide, and the book The Remote SDR Career Blueprint',
  '31 coach-reviewed assignments',
  'A quiz for every module and a final test',
  'A downloadable, verifiable certificate',
];
const sdrModules = [
  'Foundations',
  'The Surround Strategy',
  'Going Multi-Channel',
  'Cold Calling',
  'Beating the Gatekeeper',
  'The Induced Interview',
  'The Art of the Discovery',
  'Discovery Live + Recap',
];
const sdrTools = [
  'RepActs daily tracker',
  'Pipeline job-hunt CRM',
  'Quizzes',
  'Assignments',
  'Swipe Pack of 48 lines',
  'CV and LinkedIn builder with AI',
  'Leaderboard',
];

const upcoming = [
  {
    t: 'Meta Ads Bootcamp',
    tag: 'Bootcamp',
    status: 'Waitlist open',
    blurb: 'Stop boosting posts and hoping. In five live sessions you set up Meta Ads Manager properly, launch a real campaign for your business, and learn to read the numbers so you know what to fix and what to scale.',
    facts: ['5 live sessions', '6 weeks', '10 spots', '₦100,000'],
    cta: 'Save my spot',
    href: '/meta-ads-bootcamp',
    bg: 'bg-brass',
  },
  { t: 'Build with AI', tag: 'Bootcamp', status: 'Coming soon', cta: 'Join the waitlist', href: '/contact', bg: 'bg-navy' },
  { t: 'Cash-Flow Products for Creators and Influencers', tag: 'New', status: 'Coming soon', cta: 'Join the waitlist', href: '/contact', bg: 'bg-[#1e3a8a]' },
];

const steps = [
  { n: '1', t: 'Enroll and pay securely', d: 'Checkout with Paystack: card, bank transfer, or USSD.' },
  { n: '2', t: 'Get your login link', d: 'It arrives by email right after payment.' },
  { n: '3', t: 'Learn your way', d: 'Self-paced on your own schedule, live with your cohort, or one-on-one with a coach.' },
  { n: '4', t: 'Practice with feedback', d: 'Real assignments, reviewed by a coach.' },
  { n: '5', t: 'Earn your certificate', d: 'Downloadable and verifiable.' },
];

const faqs = [
  {
    q: 'Who is it for?',
    a: 'Individuals, business owners, founders, creators, influencers, and brands. If you want to earn a high-income skill, sell more, take a product to market, or build something that keeps paying you, there is a program for where you are. Beginners are welcome, and each program lists what you need to start.',
  },
  { q: 'How does payment work?', a: 'Payments run through Paystack: card, bank transfer, or USSD. Pricing is in naira for now.' },
  { q: 'What do I need to take a program?', a: 'Any phone or computer with a web browser. Everything runs online in the Academy.' },
  { q: 'How long do I get access?', a: 'It depends on the program and format. Each program lists its access.' },
  {
    q: 'I paid. Where is my login?',
    a: 'Check your email, including spam, for your login link. You can also go to <a href="https://learn.thelevihenry.com/login" class="font-semibold text-navy underline underline-offset-2">Student login</a> and choose Email me a login link.',
  },
  {
    q: 'Can I get a refund?',
    a: 'No. You get instant access to the full course the moment you pay, so all sales are final. If you have trouble logging in or accessing a lesson, <a href="/contact" class="font-semibold text-navy underline underline-offset-2">contact us</a> and we will fix it.',
  },
];

const chip = 'rounded-full border border-line bg-ivory px-3 py-1 font-sans text-xs font-semibold text-navy';
---

<Base
  title="LHG Academy | Levi Henry Group"
  description="Practical training to earn more, sell better, and build what keeps paying you. Courses, bootcamps, and one-on-one sessions from Levi Henry Group."
>
  <Header />

  <main id="main">
    <!-- HERO -->
    <section class="hero-band relative overflow-hidden border-b border-line">
      <img src="/assets/brand/bg-hero-light.webp" alt="" aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-90" />
      <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(72% 72% at 50% 42%, rgba(251,249,244,0.82), rgba(251,249,244,0.25) 58%, rgba(251,249,244,0) 100%)"></div>
      <div class="relative z-[1] mx-auto max-w-3xl px-6 py-16 text-center sm:py-20 lg:py-28">
        <p data-reveal class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">LHG Academy</p>
        <h1 data-reveal class="mt-4 font-serif text-[2.35rem] font-medium leading-[1.07] tracking-tight text-navy sm:text-5xl lg:text-[3.6rem]">
          Income skills. Revenue systems. Products that pay.
        </h1>
        <p data-reveal class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg">
          Practical training to earn more, sell better, and build what keeps paying you.
        </p>
        <div data-reveal class="mx-auto mt-8 flex max-w-sm flex-col gap-3 sm:max-w-none sm:flex-row sm:justify-center sm:gap-4">
          <a href="#programs" class="btn-primary inline-flex w-full items-center justify-center gap-2 rounded-sm px-7 py-3.5 font-sans text-sm font-semibold text-white sm:w-auto">
            Browse programs <span aria-hidden="true">&darr;</span>
          </a>
          <a href="https://learn.thelevihenry.com/login" class="inline-flex w-full items-center justify-center rounded-sm border border-navy px-7 py-3.5 font-sans text-sm font-semibold text-navy transition hover:bg-navy hover:text-white sm:w-auto">
            Student login
          </a>
        </div>
      </div>
    </section>

    <!-- FORMATS -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-7xl 2xl:max-w-[100rem] px-6 py-14 lg:py-20">
        <h2 class="font-serif text-2xl font-medium leading-tight tracking-tight text-navy sm:text-3xl" data-reveal>Ways to learn</h2>
        <div class="mt-7 grid gap-4 sm:gap-5 md:grid-cols-3">
          {formats.map((f) => (
            <div class="card-raised overflow-hidden rounded-xl border border-line bg-paper-raised p-6 transition duration-300 ease-[var(--ease-out)] hover:-translate-y-1 hover:shadow-xl hover:shadow-navy/10" style={`border-top:3px solid ${f.color}`} data-reveal>
              <span class="flex h-12 w-12 items-center justify-center rounded-xl" style={`background:${f.color}1a;color:${f.color}`}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
              </span>
              <h3 class="mt-4 font-serif text-xl font-medium text-navy">{f.t}</h3>
              <p class="mt-2 text-ink-soft">{f.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROGRAMS -->
    <section id="programs" class="scroll-mt-20 border-t border-line bg-paper">
      <div class="mx-auto max-w-7xl 2xl:max-w-[100rem] px-6 py-14 lg:py-20">
        <div class="max-w-2xl" data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">Programs</p>
          <h2 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-navy sm:text-4xl">Open now, with more on the way.</h2>
          <p class="mt-4 text-ink-soft">Every program is built around doing the work while you learn it. You apply each lesson to your own goals, so you finish with something that works: a sales pipeline, a live ad campaign, a product that earns, a skill someone will pay you for.</p>
        </div>

        <!-- Remote SDR Course (open) -->
        <article class="mt-9 overflow-hidden rounded-2xl border border-line bg-paper-raised shadow-xl shadow-navy/10 ring-1 ring-navy/[0.03]" data-reveal>
          <div class="grid lg:grid-cols-[0.92fr_1.08fr]">
            <div class="border-b border-line bg-ivory/40 p-6 sm:p-8 lg:border-b-0 lg:border-r">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-navy px-3 py-1 font-sans text-xs font-bold uppercase tracking-wider text-white">Course</span>
                <span class="rounded-full bg-brass-soft/30 px-3 py-1 font-sans text-xs font-bold uppercase tracking-wider text-navy">Open now</span>
                <span class="inline-flex items-center gap-1 font-sans text-xs font-semibold text-ink-faint">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
                  Lifetime access
                </span>
              </div>
              <h3 class="mt-4 font-serif text-2xl font-medium leading-tight text-navy sm:text-3xl">Remote SDR Course</h3>
              <p class="mt-2 text-ink-soft">Get hired as a remote sales development rep.</p>
              <div class="mt-5 overflow-hidden rounded-lg ring-1 ring-navy/10">
                <img src="/assets/photos/sdr-course-product.webp" alt="Remote SDR Mastery Course by Levi Henry Group" width="1400" height="933" loading="lazy" class="w-full" />
              </div>
              <div class="mt-7">
                <EnrollButton course="remote-sdr-training" title="Remote SDR Training" ngn={60000} listNgn={80000} />
              </div>
              <p class="mt-4 text-sm text-ink-faint">Instant access after payment: your login link arrives by email. <a href="/remote-sdr-training" class="font-semibold text-navy underline-offset-4 hover:underline">See the full course</a>.</p>
            </div>
            <div class="p-6 sm:p-8">
              <p class="font-sans text-xs font-semibold uppercase tracking-widest text-navy-600">What is inside</p>
              <ul class="mt-3 space-y-2.5">
                {sdrIncludes.map((f) => (
                  <li class="flex items-start gap-2.5 text-[0.97rem] text-ink-soft">
                    <svg class="mt-0.5 shrink-0 text-navy-600" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-6 font-sans text-xs font-semibold uppercase tracking-widest text-navy-600">The 8 modules</p>
              <ol class="mt-3 grid list-none gap-x-6 gap-y-2 sm:grid-cols-2">
                {sdrModules.map((m, i) => (
                  <li class="flex items-baseline gap-2.5 text-[0.95rem] text-ink-soft">
                    <span class="font-serif text-sm text-navy-600">{String(i + 1).padStart(2, '0')}</span>
                    <span>{m}</span>
                  </li>
                ))}
              </ol>
              <p class="mt-6 font-sans text-xs font-semibold uppercase tracking-widest text-navy-600">7 tools to practice and get hired</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {sdrTools.map((t) => <span class={chip}>{t}</span>)}
              </div>
            </div>
          </div>
        </article>

        <!-- Upcoming -->
        <div class="mt-5 grid gap-5 md:grid-cols-3">
          {upcoming.map((c) => (
            <a
              href={c.href}
              data-reveal
              class:list={[c.bg, 'group relative flex min-h-[300px] flex-col overflow-hidden rounded-2xl p-6 text-white shadow-xl shadow-navy/15 ring-1 ring-white/10 transition duration-300 ease-[var(--ease-out)] hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-navy/40 sm:p-7']}
            >
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white/12 via-transparent to-black/15"></div>
              <div aria-hidden="true" class="pointer-events-none absolute inset-0 -translate-x-full bg-[linear-gradient(115deg,transparent_32%,rgba(255,255,255,0.14)_50%,transparent_68%)] transition-transform duration-700 ease-[var(--ease-out)] group-hover:translate-x-full"></div>
              <div class="relative flex flex-wrap items-center gap-2">
                <span class="rounded-full border border-white/25 px-3 py-1 font-sans text-xs font-bold uppercase tracking-wider text-white/80">{c.tag}</span>
                {c.status === 'Waitlist open' ? (
                  <span class="rounded-full bg-white/20 px-3 py-1 font-sans text-xs font-bold uppercase tracking-wider text-white">{c.status}</span>
                ) : (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-beacon-soft/15 px-3 py-1 font-sans text-xs font-bold uppercase tracking-wider text-beacon-soft ring-1 ring-beacon-soft/25">
                    <span class="h-1.5 w-1.5 rounded-full bg-beacon-soft motion-safe:animate-pulse" aria-hidden="true"></span>
                    {c.status}
                  </span>
                )}
              </div>
              <h3 class="relative mt-4 font-serif text-xl font-medium leading-snug">{c.t}</h3>
              {c.blurb ? (
                <p class="relative mt-2 text-[0.95rem] leading-relaxed text-white/85">{c.blurb}</p>
              ) : (
                <p class="relative mt-2 text-[0.95rem] leading-relaxed text-white/80">Join the waitlist and you will hear the moment it opens.</p>
              )}
              {c.facts && (
                <ul class="relative mt-4 flex flex-wrap gap-2">
                  {c.facts.map((f) => <li class="rounded-full border border-white/25 px-3 py-1 text-xs font-semibold text-white/85">{f}</li>)}
                </ul>
              )}
              <span class="relative mt-auto inline-flex w-fit items-center gap-2 border-b border-white/50 pb-0.5 pt-6 font-sans text-sm font-semibold">
                {c.cta} <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS (dark band) -->
    <section class="band-dark relative overflow-hidden">
      <BandTexture src="/assets/brand/bg-topo.webp" mirror={false} opacity={0.2} />
      <div class="relative z-[1] mx-auto max-w-7xl 2xl:max-w-[100rem] px-6 py-14 lg:py-24">
        <div class="max-w-2xl" data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-brass-soft">How it works</p>
          <h2 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-white sm:text-4xl">From payment to certificate.</h2>
        </div>
        <div class="mt-9 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-5">
          {steps.map((s) => (
            <div data-reveal>
              <span class="flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/5 font-serif text-lg font-medium text-brass-soft">{s.n}</span>
              <h3 class="mt-4 font-serif text-lg font-medium text-white">{s.t}</h3>
              <p class="mt-1.5 text-[0.95rem] leading-relaxed text-white/70">{s.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CERTIFICATES -->
    <section class="border-t border-line">
      <div class="mx-auto grid max-w-7xl 2xl:max-w-[100rem] items-center gap-10 px-6 py-14 lg:grid-cols-2 lg:gap-16 lg:py-20">
        <div data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">Certificates</p>
          <h2 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-navy sm:text-4xl">Every certificate can be verified.</h2>
          <p class="mt-5 text-ink-soft">Finish a program and you earn a certificate you can download and share. Each one carries a unique ID and a public verification link, so an employer can confirm it is real in one click.</p>
          <p class="mt-4 text-ink-soft">The link opens a page that shows the name, the program, and the date, and nothing else.</p>
        </div>
        <div class="card-raised rounded-2xl border border-line bg-paper-raised p-6 shadow-xl shadow-navy/10 sm:p-7" data-reveal>
          <div class="flex items-center gap-2 text-navy-600">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
            <p class="font-sans text-xs font-semibold uppercase tracking-widest">Verify a certificate</p>
          </div>
          <p class="mt-3 break-all rounded-lg bg-ivory px-3 py-2.5 font-mono text-sm text-ink-soft">learn.thelevihenry.com/verify/<span class="text-navy">&lt;id&gt;</span></p>
          <div class="mt-5 space-y-2 border-t border-line pt-5 text-sm text-ink-soft">
            <p><span class="font-semibold text-navy">Name:</span> the student</p>
            <p><span class="font-semibold text-navy">Program:</span> the program completed</p>
            <p><span class="font-semibold text-navy">Date:</span> when it was earned</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="border-t border-line bg-paper">
      <div class="mx-auto max-w-3xl px-6 py-14 lg:py-20">
        <h2 class="font-serif text-3xl font-medium leading-tight tracking-tight text-navy sm:text-4xl" data-reveal>Questions</h2>
        <div class="mt-7 border-t border-line" data-reveal>
          {faqs.map((f) => (
            <details class="group border-b border-line">
              <summary class="flex min-h-[3.25rem] cursor-pointer list-none items-center justify-between gap-4 py-4 font-serif text-lg font-medium text-navy [&::-webkit-details-marker]:hidden">
                <span>{f.q}</span>
                <svg class="h-5 w-5 shrink-0 text-navy-600 transition-transform duration-300 group-open:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
              </summary>
              <p class="pb-5 text-ink-soft" set:html={f.a} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CLOSING CTA (dark band) -->
    <section class="band-dark relative overflow-hidden border-t border-white/10">
      <BandTexture src="/assets/brand/bg-gold-streak.webp" mirror={false} opacity={0.26} />
      <div class="relative z-[1] mx-auto max-w-3xl px-6 py-14 text-center lg:py-20" data-reveal>
        <h2 class="font-serif text-3xl font-medium leading-tight tracking-tight text-white sm:text-4xl">Pick a program and get going.</h2>
        <p class="mx-auto mt-4 max-w-xl text-white/75">The Remote SDR Course is open now. More programs are on the way.</p>
        <div class="mx-auto mt-8 flex max-w-sm flex-col gap-3 sm:max-w-none sm:flex-row sm:justify-center sm:gap-4">
          <a href="#programs" class="inline-flex w-full items-center justify-center gap-2 rounded-sm bg-white px-7 py-3.5 font-sans text-sm font-semibold text-navy shadow-lg shadow-black/20 transition hover:bg-ivory-deep sm:w-auto">Browse programs</a>
          <a href="https://learn.thelevihenry.com/login" class="inline-flex w-full items-center justify-center rounded-sm border border-white/40 px-7 py-3.5 font-sans text-sm font-semibold text-white transition hover:bg-white/10 sm:w-auto">Student login</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
