---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BandTexture from '../components/BandTexture.astro';
import EnrollButton from '../components/EnrollButton.astro';

const formats = [
  { t: 'Bootcamps', d: 'Live cohorts. Learn with a group on set dates.' },
  { t: 'Courses', d: 'Self-paced. Learn on your own schedule.' },
  { t: 'One-on-one sessions', d: 'Personal coaching built around your goals.' },
];

const sdrIncludes = [
  '116 video lessons, 18 hours, across 8 modules, plus a free Start here training and a bonus session',
  '8 module guides, an interview companion guide, and the book The Remote SDR Career Blueprint',
  '31 coach-reviewed assignments',
  'A quiz for every module and a final test',
  'A downloadable, verifiable certificate',
];
const sdrModules = [
  'Foundations',
  'The Surround Strategy',
  'Going Multi-Channel',
  'Cold Calling',
  'Beating the Gatekeeper',
  'The Induced Interview',
  'The Art of the Discovery',
  'Discovery Live + Recap',
];
const sdrTools = [
  'RepActs daily tracker',
  'Pipeline job-hunt CRM',
  'Quizzes',
  'Assignments',
  'Swipe Pack of 48 lines',
  'CV and LinkedIn builder with AI',
  'Leaderboard',
];

const upcoming = [
  {
    t: 'Meta Ads Bootcamp',
    tag: 'Bootcamp',
    status: 'Waitlist open',
    blurb: 'Stop boosting posts and hoping. In five live sessions you set up Meta Ads Manager properly, launch a real campaign for your business, and learn to read the numbers so you know what to fix and what to scale.',
    facts: ['5 live sessions', '6 weeks', '10 spots', '₦100,000'],
    cta: 'Save my spot',
    href: '/meta-ads-bootcamp',
  },
  { t: 'Build with AI', tag: 'Bootcamp', status: 'Coming soon', cta: 'Join the waitlist', href: '/contact' },
  { t: 'Cash-Flow Products for Creators and Influencers', tag: 'New', status: 'Coming soon', cta: 'Join the waitlist', href: '/contact' },
];

const steps = [
  { n: '01', t: 'Enroll and pay securely', d: 'Checkout with Paystack: card, bank transfer, or USSD.' },
  { n: '02', t: 'Get your login link', d: 'It arrives by email right after payment.' },
  { n: '03', t: 'Learn your way', d: 'Self-paced on your own schedule, or live with your cohort.' },
  { n: '04', t: 'Practice with feedback', d: 'Real assignments, reviewed by a coach.' },
  { n: '05', t: 'Earn your certificate', d: 'Downloadable and verifiable.' },
];

const chip = 'rounded-full border border-line bg-ivory px-3 py-1 font-sans text-xs font-semibold text-navy';
---

<Base
  title="LHG Academy | Levi Henry Group"
  description="Practical training to earn more, sell better, and build what keeps paying you. Courses, bootcamps, and one-on-one sessions from Levi Henry Group."
>
  <Header />

  <main id="main">
    <!-- HERO -->
    <section class="hero-band relative overflow-hidden border-b border-line">
      <div class="mx-auto max-w-3xl px-6 py-20 text-center lg:py-28">
        <p data-reveal class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">LHG Academy</p>
        <h1 data-reveal class="mt-4 font-serif text-[2.5rem] font-medium leading-[1.06] tracking-tight text-navy sm:text-5xl lg:text-[3.6rem]">
          Income skills. Revenue systems. Products that pay.
        </h1>
        <p data-reveal class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
          Practical training to earn more, sell better, and build what keeps paying you.
        </p>
        <div data-reveal class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#programs" class="btn-primary inline-flex items-center gap-2 rounded-sm px-7 py-3.5 font-sans text-sm font-semibold text-white">
            Browse programs <span aria-hidden="true">&darr;</span>
          </a>
          <a href="https://learn.thelevihenry.com/login" class="inline-flex items-center rounded-sm border border-navy px-7 py-3.5 font-sans text-sm font-semibold text-navy transition hover:bg-navy hover:text-white">
            Student login
          </a>
        </div>
      </div>
    </section>

    <!-- FORMATS -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-7xl 2xl:max-w-[100rem] px-6 py-16 lg:py-20">
        <h2 class="font-serif text-3xl font-medium leading-tight tracking-tight text-navy sm:text-4xl" data-reveal>Ways to learn</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {formats.map((f) => (
            <div class="rounded-lg border border-line bg-paper-raised p-6 card-raised" data-reveal>
              <h3 class="font-serif text-xl font-medium text-navy">{f.t}</h3>
              <p class="mt-2 text-ink-soft">{f.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROGRAMS -->
    <section id="programs" class="scroll-mt-24 border-t border-line bg-paper">
      <div class="mx-auto max-w-7xl 2xl:max-w-[100rem] px-6 py-16 lg:py-20">
        <div class="max-w-2xl" data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">Programs</p>
          <h2 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-navy sm:text-4xl">Open now, with more on the way.</h2>
          <p class="mt-4 text-ink-soft">Every program is built around doing the work while you learn it. You apply each lesson to your own goals, so you finish with something that works: a sales pipeline, a live ad campaign, a product that earns, a skill someone will pay you for.</p>
        </div>

        <!-- Remote SDR Course (open) -->
        <article class="mt-10 overflow-hidden rounded-xl border border-line bg-paper-raised shadow-xl shadow-navy/10" data-reveal>
          <div class="grid lg:grid-cols-[0.95fr_1.05fr]">
            <div class="border-b border-line p-7 sm:p-9 lg:border-b-0 lg:border-r">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-navy px-3 py-1 font-sans text-xs font-bold uppercase tracking-wider text-white">Course</span>
                <span class="rounded-full bg-brass-soft/25 px-3 py-1 font-sans text-xs font-bold uppercase tracking-wider text-navy">Open now</span>
                <span class="font-sans text-xs font-semibold text-ink-faint">Lifetime access</span>
              </div>
              <h3 class="mt-4 font-serif text-2xl font-medium leading-tight text-navy sm:text-3xl">Remote SDR Course</h3>
              <p class="mt-2 text-ink-soft">Get hired as a remote sales development rep.</p>
              <div class="mt-4 overflow-hidden rounded-lg ring-1 ring-navy/10">
                <img src="/assets/photos/sdr-course-product.webp" alt="Remote SDR Mastery Course by Levi Henry Group" width="1400" height="933" loading="lazy" class="w-full" />
              </div>
              <div class="mt-7">
                <EnrollButton course="remote-sdr-training" title="Remote SDR Training" ngn={60000} listNgn={80000} />
              </div>
              <p class="mt-4 text-sm text-ink-faint">Instant access after payment: your login link arrives by email. <a href="/individuals" class="font-semibold text-navy underline-offset-4 hover:underline">See full details</a>.</p>
            </div>
            <div class="p-7 sm:p-9">
              <p class="font-sans text-xs font-semibold uppercase tracking-widest text-navy-600">What is inside</p>
              <ul class="mt-3 space-y-2.5">
                {sdrIncludes.map((f) => (
                  <li class="flex items-start gap-2.5 text-[0.97rem] text-ink-soft">
                    <svg class="mt-0.5 shrink-0 text-navy-600" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-6 font-sans text-xs font-semibold uppercase tracking-widest text-navy-600">The 8 modules</p>
              <ol class="mt-3 grid list-none gap-x-6 gap-y-1.5 sm:grid-cols-2">
                {sdrModules.map((m, i) => (
                  <li class="flex gap-2.5 text-[0.95rem] text-ink-soft">
                    <span class="font-serif text-navy-600">{String(i + 1).padStart(2, '0')}</span>
                    <span>{m}</span>
                  </li>
                ))}
              </ol>
              <p class="mt-6 font-sans text-xs font-semibold uppercase tracking-widest text-navy-600">7 tools to practice and get hired</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {sdrTools.map((t) => <span class={chip}>{t}</span>)}
              </div>
            </div>
          </div>
        </article>

        <!-- Coming soon -->
        <div class="mt-5 grid gap-5 md:grid-cols-3">
          {upcoming.map((c) => (
            <div class="flex flex-col rounded-xl border border-line bg-paper-raised p-7" data-reveal>
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full border border-line px-3 py-1 font-sans text-xs font-bold uppercase tracking-wider text-ink-soft">{c.tag}</span>
                <span class:list={['rounded-full px-3 py-1 font-sans text-xs font-bold uppercase tracking-wider', c.status === 'Waitlist open' ? 'bg-brass-soft/25 text-navy' : 'bg-ivory-deep text-ink-faint']}>{c.status}</span>
              </div>
              <h3 class="mt-4 font-serif text-xl font-medium leading-snug text-navy">{c.t}</h3>
              {c.blurb && <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">{c.blurb}</p>}
              {c.facts && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {c.facts.map((f) => <li class={chip}>{f}</li>)}
                </ul>
              )}
              <a href={c.href} class="mt-auto inline-flex items-center gap-2 border-b border-navy/40 pb-0.5 pt-6 font-sans text-sm font-semibold text-navy w-fit">
                {c.cta} <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS (dark band) -->
    <section class="band-dark relative overflow-hidden">
      <BandTexture src="/assets/brand/bg-topo.webp" mirror={false} opacity={0.2} />
      <div class="relative z-[1] mx-auto max-w-7xl 2xl:max-w-[100rem] px-6 py-16 lg:py-24">
        <div class="max-w-2xl" data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-brass-soft">How it works</p>
          <h2 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-white sm:text-4xl">From payment to certificate.</h2>
        </div>
        <div class="mt-10 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
          {steps.map((s) => (
            <div class="flex gap-5 border-t border-white/10 py-6" data-reveal>
              <span class="font-serif text-2xl font-medium leading-none text-brass-soft">{s.n}</span>
              <div>
                <h3 class="font-serif text-lg font-medium text-white">{s.t}</h3>
                <p class="mt-1.5 text-[0.95rem] leading-relaxed text-white/70">{s.d}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CERTIFICATES -->
    <section class="border-t border-line">
      <div class="mx-auto grid max-w-7xl 2xl:max-w-[100rem] items-center gap-10 px-6 py-16 lg:grid-cols-2 lg:gap-16 lg:py-20">
        <div data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">Certificates</p>
          <h2 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-navy sm:text-4xl">Every certificate can be verified.</h2>
          <p class="mt-5 text-ink-soft">Finish a program and you earn a certificate you can download and share. Each one carries a unique ID and a public verification link, so an employer can confirm it is real in one click.</p>
          <p class="mt-4 text-ink-soft">The link opens a page that shows the name, the program, and the date, and nothing else.</p>
        </div>
        <div class="rounded-xl border border-line bg-paper-raised p-7 shadow-xl shadow-navy/10 card-raised" data-reveal>
          <p class="font-sans text-xs font-semibold uppercase tracking-widest text-navy-600">Verify a certificate</p>
          <p class="mt-3 font-mono text-sm text-ink-soft">learn.thelevihenry.com/verify/<span class="text-navy">&lt;id&gt;</span></p>
          <div class="mt-5 space-y-2 border-t border-line pt-5 text-sm text-ink-soft">
            <p><span class="font-semibold text-navy">Name:</span> the student</p>
            <p><span class="font-semibold text-navy">Program:</span> the program completed</p>
            <p><span class="font-semibold text-navy">Date:</span> when it was earned</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="border-t border-line bg-paper">
      <div class="mx-auto max-w-3xl px-6 py-16 lg:py-20">
        <h2 class="font-serif text-3xl font-medium leading-tight tracking-tight text-navy sm:text-4xl" data-reveal>Questions</h2>
        <dl class="mt-8 divide-y divide-line border-t border-line">
          <div class="py-6" data-reveal>
            <dt class="font-serif text-lg font-medium text-navy">Who is it for?</dt>
            <dd class="mt-2 text-ink-soft">Individuals, business owners, founders, creators, influencers, and brands. If you want to earn a high-income skill, sell more, take a product to market, or build something that keeps paying you, there is a program for where you are. Beginners are welcome, and each program lists what you need to start.</dd>
          </div>
          <div class="py-6" data-reveal>
            <dt class="font-serif text-lg font-medium text-navy">How does payment work?</dt>
            <dd class="mt-2 text-ink-soft">Payments run through Paystack: card, bank transfer, or USSD. Pricing is in naira for now.</dd>
          </div>
          <div class="py-6" data-reveal>
            <dt class="font-serif text-lg font-medium text-navy">What do I need to take a program?</dt>
            <dd class="mt-2 text-ink-soft">Any phone or computer with a web browser. Everything runs online in the Academy.</dd>
          </div>
          <div class="py-6" data-reveal>
            <dt class="font-serif text-lg font-medium text-navy">How long do I get access?</dt>
            <dd class="mt-2 text-ink-soft">It depends on the program and format. Each program lists its access.</dd>
          </div>
          <div class="py-6" data-reveal>
            <dt class="font-serif text-lg font-medium text-navy">I paid. Where is my login?</dt>
            <dd class="mt-2 text-ink-soft">Check your email, including spam, for your login link. You can also go to <a href="https://learn.thelevihenry.com/login" class="font-semibold text-navy underline underline-offset-2">Student login</a> and choose Email me a login link.</dd>
          </div>
          <div class="py-6" data-reveal>
            <dt class="font-serif text-lg font-medium text-navy">Can I get a refund?</dt>
            <dd class="mt-2 text-ink-soft">Refund requests are reviewed case by case. If something is not right, contact us through the <a href="/contact" class="font-semibold text-navy underline underline-offset-2">Contact page</a> with your payment email and what happened, and we will respond within 2 business days.</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- CLOSING CTA (dark band) -->
    <section class="band-dark relative overflow-hidden border-t border-white/10">
      <BandTexture src="/assets/brand/bg-gold-streak.webp" mirror={false} opacity={0.26} />
      <div class="relative z-[1] mx-auto max-w-3xl px-6 py-16 text-center lg:py-20" data-reveal>
        <h2 class="font-serif text-3xl font-medium leading-tight tracking-tight text-white sm:text-4xl">Pick a program and get going.</h2>
        <p class="mx-auto mt-4 max-w-xl text-white/75">The Remote SDR Course is open now. More programs are on the way.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#programs" class="inline-flex items-center gap-2 rounded-sm bg-white px-7 py-3.5 font-sans text-sm font-semibold text-navy shadow-lg shadow-black/20 transition hover:bg-ivory-deep">Browse programs</a>
          <a href="https://learn.thelevihenry.com/login" class="inline-flex items-center rounded-sm border border-white/40 px-7 py-3.5 font-sans text-sm font-semibold text-white transition hover:bg-white/10">Student login</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
