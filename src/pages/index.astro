---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const fork = [
  { n: '01 — For Individuals', h: 'Build high-income skills', href: '/individuals',
    d: 'Sales development and the real, transferable skills that make you valuable in any market, taught as a craft you build, not a hobby you dabble in.',
    cta: 'Explore individual programs', bg: 'bg-brass' },
  { n: '02 — For Businesses', h: 'Implement systems for growth', href: '/businesses',
    d: 'Marketing, paid acquisition, funnels, and the revenue infrastructure that turns traffic into paying customers, built and advised on end to end.',
    cta: 'Explore business services', bg: 'bg-navy' },
  { n: '03 — For Founders', h: 'Take your platform to market', href: '/founders',
    d: "You built something that solves a real problem. We help you work out who it's for, how to price it, and how to land your first real users.",
    cta: 'Explore GTM consulting', bg: 'bg-[#1e3a8a]' },
];

const pillars = [
  { i: '01', h: 'Consulting', a: 'Strategy', d: 'Hands-on guidance for individuals and small businesses building or scaling sales development, marketing, and revenue operations, drawing on 15+ years of experience across business, sales, sales leadership and channel partnerships.' },
  { i: '02', h: 'Education', a: 'Skills', d: 'Practical training and resources that build high-income skills, from sales development and outbound prospecting to marketing and paid acquisition, so you can build sustainable income on your own terms.' },
  { i: '03', h: 'Technology Services', a: 'Build', d: 'End-to-end build support for the infrastructure that makes revenue systems actually work: websites, funnels, payment integration, and the technical backbone behind client acquisition and sales.' },
];

const testimonials = [
  { name: 'Geoffrey', poster: '/assets/photos/poster-geoffrey.jpg', src: '/assets/video/testimonial-geoffrey.mp4' },
  { name: 'Manny', poster: '/assets/photos/poster-manny.jpg', src: '/assets/video/testimonial-manny.mp4' },
];
---

<Base
  title="Levi Henry Group — Building the people and systems that produce revenue"
  description="Consulting, education, and technology services helping individuals build high-income skills and businesses build the systems that generate revenue."
>
  <Header />

  <main id="main">
    <!-- HERO -->
    <section class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:py-20">
      <div>
        <h1 data-reveal class="font-serif text-[2.6rem] font-medium leading-[1.05] tracking-tight text-navy sm:text-5xl lg:text-[4.2rem]">
          Building the people and systems that produce revenue.
        </h1>
        <p data-reveal class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
          A consulting, education, and technology company. We help individuals build
          high-income skills, and we help businesses build the systems and the tech that turn
          effort into revenue.
        </p>
        <div data-reveal class="mt-8 flex flex-wrap gap-4">
          <a href="/contact" class="btn-primary group inline-flex items-center gap-2 rounded-sm px-7 py-3.5 font-sans text-sm font-semibold text-white">
            Book a call <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
          <a href="/about" class="inline-flex items-center rounded-sm border border-navy px-7 py-3.5 font-sans text-sm font-semibold text-navy transition hover:bg-navy hover:text-white">
            Read the story
          </a>
        </div>
      </div>
      <figure class="panel-brand group relative m-0 aspect-[4/5] overflow-hidden rounded-2xl shadow-2xl shadow-navy/40 ring-1 ring-white/10" data-reveal>
        <div class="beacon-glow"></div>
        <img
          src="/assets/photos/levi-hero-pointup.webp"
          alt="Levi Henry, founder of Levi Henry Group"
          width="1000"
          height="1389"
          class="absolute inset-0 z-[1] h-full w-full object-cover object-top transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out)] group-hover:scale-[1.03]"
          fetchpriority="high"
        />
        <figcaption class="absolute bottom-4 left-4 z-[2] rounded-md bg-black/25 px-4 py-2 font-sans text-sm text-white backdrop-blur-sm">Levi Henry <b class="text-beacon-soft">·</b> Founder</figcaption>
      </figure>
    </section>

    <!-- STORY -->
    <section class="border-t border-line bg-paper">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-16 lg:grid-cols-2 lg:gap-16 lg:py-20">
        <div class="group overflow-hidden rounded-lg bg-navy shadow-2xl shadow-navy/30" data-reveal>
          <img src="/assets/photos/portrait-seated.jpg" alt="Levi Henry seated" width="1440" height="1800" loading="lazy" class="aspect-[4/5] w-full object-cover transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out)] group-hover:scale-[1.03]" />
        </div>
        <div data-reveal>
          <h2 class="font-serif text-3xl font-medium leading-tight tracking-tight text-navy sm:text-4xl">Built on experience that produces revenue.</h2>
          <div class="mt-5 space-y-4 text-ink-soft">
            <p>Levi Henry Group draws on 15+ years across business, sales, sales leadership, and channel partnerships, working with businesses across North America, from million to billion-dollar companies, and learning how successful businesses actually run: the tech they rely on, how to pick the right tools for the job, how to build and train sales teams, how to generate leads inbound and outbound, and how to manage a pipeline all the way to revenue.</p>
            <p>That experience is now pointed at you: building the people and the systems that turn effort into revenue, for individuals and small businesses alike.</p>
            <p class="font-serif text-xl text-navy">Levi Henry Group exists to build the people and systems that produce revenue.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- AUDIENCE FORK -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
        <h2 class="max-w-2xl font-serif text-3xl font-medium leading-tight tracking-tight text-navy sm:text-4xl" data-reveal>Whether you're building yourself, a business, or a startup.</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {fork.map((c) => (
            <a href={c.href} class:list={[c.bg, 'group relative flex min-h-[320px] flex-col overflow-hidden rounded-md p-8 text-white shadow-xl shadow-navy/15 ring-1 ring-white/10 transition duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-navy/40']} data-reveal>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white/12 via-transparent to-black/15"></div>
              <span class="relative font-sans text-xs font-semibold uppercase tracking-widest text-white/75">{c.n}</span>
              <h3 class="relative mt-auto pt-8 font-serif text-2xl font-medium">{c.h}</h3>
              <p class="relative mt-3 text-white/85">{c.d}</p>
              <span class="relative mt-5 inline-flex items-center gap-2 border-b border-white/50 pb-0.5 font-sans text-sm font-semibold">
                {c.cta} <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- PILLARS (dark band for rhythm) -->
    <section class="band-dark">
      <div class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
        <div class="max-w-2xl" data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-brass-soft">What we do</p>
          <h2 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-white sm:text-4xl">Three core areas, under one roof.</h2>
        </div>
        <div class="mt-10">
          {pillars.map((p) => (
            <div class="grid grid-cols-[auto_1fr] items-start gap-x-8 gap-y-1 border-t border-white/10 py-8 sm:grid-cols-[auto_1fr_auto]" data-reveal>
              <span class="font-serif text-2xl font-medium leading-none text-brass-soft sm:text-3xl">{p.i}</span>
              <div class="max-w-[54ch]">
                <h3 class="font-serif text-xl font-medium text-white">{p.h}</h3>
                <p class="mt-2 text-white/70">{p.d}</p>
              </div>
              <span class="hidden font-sans text-[0.7rem] font-semibold uppercase tracking-widest text-white/40 sm:block">{p.a}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
        <div class="max-w-2xl" data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">In their words</p>
          <h2 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-navy sm:text-4xl">What clients say.</h2>
        </div>
        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {testimonials.map((t) => (
            <div class="overflow-hidden rounded-lg bg-navy-deep shadow-2xl shadow-navy/30" data-reveal>
              <video class="aspect-[9/12] w-full object-cover" controls preload="none" playsinline poster={t.poster} src={t.src}></video>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
        <div class="band-dark relative overflow-hidden rounded-2xl px-8 py-14 text-center ring-1 ring-white/10 sm:px-14" data-reveal>
          <div class="beacon-glow"></div>
          <p class="relative z-[1] font-sans text-xs font-bold uppercase tracking-[0.2em] text-white/60">Let's build</p>
          <h2 class="relative z-[1] mx-auto mt-3 max-w-lg font-serif text-3xl font-medium leading-tight tracking-tight text-white sm:text-4xl">Ready to turn what you know into revenue?</h2>
          <p class="relative z-[1] mx-auto mt-4 max-w-xl text-white/75">Whether you're an individual building a high-income skill or a business building the systems behind growth, let's talk about where you are and what's next.</p>
          <a href="/contact" class="relative z-[1] mt-8 inline-flex items-center gap-2 rounded-sm bg-white px-7 py-3.5 font-sans text-sm font-semibold text-navy shadow-lg shadow-black/20 transition hover:bg-ivory-deep">Book a call <span>&rarr;</span></a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
