---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BandTexture from '../components/BandTexture.astro';
import EnrollButton from '../components/EnrollButton.astro';

const courseIncludes = [
  '116 video lessons · 18 hours · 8 modules',
  'Module guides and the career blueprint book',
  '31 coach-reviewed assignments',
  'Quizzes and a downloadable certificate',
];
const build = [
  { t: 'Prospecting & outreach', d: 'Find the right people and start real conversations, inbound and outbound, without sounding like a script.' },
  { t: 'Discovery & qualification', d: 'Ask the questions that surface real needs and separate buyers from browsers.' },
  { t: 'Presenting & closing', d: 'Move a conversation to a decision with confidence and integrity: the part most people avoid.' },
  { t: 'Pipeline discipline', d: 'Track, follow up, and manage opportunities so nothing valuable slips.' },
  { t: 'Positioning yourself', d: 'Price your work and communicate your value with the confidence buyers respond to.' },
];
const steps = [
  { i: '01', h: 'Assess & aim', a: 'Foundation', d: 'We start with where you are and what income the skill needs to produce. No generic curriculum, just a plan pointed at your goal.' },
  { i: '02', h: 'Practice with feedback', a: 'Reps', d: 'Live reps, review, and correction. You do the work and we coach the tape, call by call.' },
  { i: '03', h: 'Apply it for real', a: 'Revenue', d: 'Take the skill into an actual role, offer, or freelance pipeline, and refine it against real outcomes.' },
];
const provider = { '@type': 'Organization', name: 'Levi Henry Group', url: 'https://thelevihenry.com' };
const courseLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Remote SDR Mastery Course: Break In and Become a Top Performer',
  description:
    'A structured, job-ready course that builds the practical skills of a remote Sales Development Rep: prospecting and outreach, discovery, objection handling, and pipeline management. Eight modules, each with 10 to 16 videos.',
  provider,
  url: 'https://thelevihenry.com/individuals',
  inLanguage: 'en',
};
const ebookLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: 'The Remote SDR Career Blueprint',
  bookFormat: 'https://schema.org/EBook',
  description:
    "A complete beginner's ebook for breaking into remote tech sales: the exact path from no experience to a paid Sales Development role.",
  author: provider,
  publisher: provider,
  isAccessibleForFree: true,
  url: 'https://thelevihenry.com/individuals',
  inLanguage: 'en',
};
---

<Base
  title="For Individuals | Levi Henry Group"
  description="Build a high-income sales skill you can carry anywhere — real reps, honest coaching, and job-ready SDR training."
  jsonld={[courseLd, ebookLd]}
>
  <Header />

  <main id="main">
    <!-- HERO -->
    <section class="mx-auto max-w-7xl 2xl:max-w-[100rem] px-6 py-14 lg:py-20">
      <div class="max-w-3xl">
        <p data-reveal class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">For Individuals</p>
        <h1 data-reveal class="mt-4 font-serif text-4xl font-medium leading-[1.07] tracking-tight text-navy sm:text-5xl">Build a high-income skill you can carry anywhere.</h1>
        <p data-reveal class="mt-5 max-w-2xl text-lg text-ink-soft">Sales is the most transferable, highest-leverage skill you can own. We teach it as a real craft, with real reps and honest coaching, not a shelf of courses you never finish.</p>
      </div>
    </section>

    <!-- FREE VIDEO TRAINING (dark band) -->
    <section class="band-dark relative overflow-hidden">
      <BandTexture src="/assets/brand/bg-lowpoly.webp" mirror={false} opacity={0.2} />
      <div class="relative z-[1] mx-auto max-w-7xl 2xl:max-w-[100rem] px-6 py-16 lg:py-20">
        <div class="mx-auto max-w-2xl text-center" data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-brass-soft">Free video training</p>
          <h2 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-white sm:text-4xl">How to Break into Remote Tech Sales as an SDR</h2>
          <p class="mt-4 text-white/75">A free walkthrough of the exact path from no experience to a paid Sales Development role. Watch it first, then go deeper with the blueprint and course below.</p>
        </div>
        <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-lg shadow-2xl shadow-navy-deep/50 ring-1 ring-white/10" data-reveal>
          <div class="relative aspect-video">
            <iframe class="absolute inset-0 h-full w-full" src="https://www.youtube-nocookie.com/embed/7DcjJEdP5s4" title="How to Break into Remote Tech Sales as an SDR" loading="lazy" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- WHO / WHAT -->
    <section class="border-t border-line">
      <div class="mx-auto grid max-w-7xl 2xl:max-w-[100rem] gap-10 px-6 py-16 lg:grid-cols-[0.85fr_1.15fr] lg:py-20">
        <div data-reveal>
          <div class="rounded-lg border border-line border-l-[3px] border-l-brass bg-paper p-7">
            <h4 class="font-sans text-xs font-semibold uppercase tracking-wider text-brass-deep">Who it's for</h4>
            <p class="mt-3 text-ink-soft">Career-changers, creatives, and early-stage professionals who want an income-producing skill they control, people who'd rather build capability than chase another certificate. If you learn by doing and want honest coaching, this is for you.</p>
          </div>
        </div>
        <div>
          <p data-reveal class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">What you'll build</p>
          <div class="mt-4 grid gap-3">
            {build.map((s) => (
              <div class="rounded-lg border border-line bg-paper-raised p-5 transition duration-300 hover:-translate-y-1 hover:border-navy-600/40 hover:shadow-lg hover:shadow-navy/10" data-reveal>
                <strong class="block font-bold text-navy">{s.t}</strong>
                <span class="mt-1.5 block text-[0.93rem] leading-relaxed text-ink-soft">{s.d}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- BOOK -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-7xl 2xl:max-w-[100rem] px-6 py-16 lg:py-20">
        <div class="mx-auto max-w-4xl" data-reveal>
          <img src="/assets/photos/sdr-ebook-product.webp" alt="The Remote SDR Career Blueprint ebook by Levi Henry Group" width="1400" height="933" loading="lazy" class="w-full rounded-lg shadow-2xl shadow-navy/25 ring-1 ring-navy/10 transition duration-300 ease-[var(--ease-out)] hover:-translate-y-1.5 hover:shadow-navy/35" />
        </div>
        <div class="mx-auto mt-10 max-w-2xl text-center" data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">Free ebook</p>
          <h2 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-navy sm:text-4xl">The Remote SDR Career Blueprint</h2>
          <p class="mt-4 text-ink-soft">Our complete beginner's ebook for breaking into remote tech sales: the exact path from no experience to a paid Sales Development role. It's the foundation the coaching builds on — and it's yours free.</p>
          <form method="POST" action="/.netlify/functions/ebook" class="mx-auto mt-6 flex max-w-md flex-col gap-3 sm:flex-row">
            <p hidden><label>Leave this empty: <input name="bot-field" /></label></p>
            <input type="email" name="email" required autocomplete="email" placeholder="Enter your email" class="w-full rounded-sm border border-line-strong bg-white px-4 py-3 text-ink transition focus:border-brass focus:outline-none focus:ring-2 focus:ring-brass/20" />
            <button type="submit" class="btn-primary shrink-0 rounded-sm px-6 py-3 font-sans text-sm font-semibold text-white">Get the free ebook</button>
          </form>
          <p class="mt-3 text-sm text-ink-faint">Sent straight to your inbox, free. <a href="/contact" class="underline decoration-navy/30 underline-offset-2 hover:text-navy">Ask about coaching &rarr;</a></p>
        </div>
      </div>
    </section>

    <!-- COURSE -->
    <section class="border-t border-line bg-paper">
      <div class="mx-auto max-w-7xl 2xl:max-w-[100rem] px-6 py-16 lg:py-20">
        <div class="mx-auto max-w-4xl" data-reveal>
          <img src="/assets/photos/sdr-course-product.webp" alt="Remote SDR Mastery Course by Levi Henry Group — course box, video lessons, and modules" width="1400" height="933" loading="lazy" class="w-full rounded-lg shadow-2xl shadow-navy/25 ring-1 ring-navy/10 transition duration-300 ease-[var(--ease-out)] hover:-translate-y-1.5 hover:shadow-navy/35" />
        </div>
        <div class="mx-auto mt-10 max-w-2xl text-center" data-reveal>
          <a href="/academy" class="group mb-3 inline-flex items-center gap-1.5 font-sans text-xs font-semibold uppercase tracking-wider text-navy-600 transition hover:text-navy">
            <span aria-hidden="true" class="transition-transform group-hover:-translate-x-0.5">&larr;</span> Part of LHG Academy
          </a>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">New · enrollment open</p>
          <h2 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-navy sm:text-4xl">Remote SDR Mastery Course: Break In and Become a Top Performer</h2>
          <p class="mt-4 text-ink-soft">A structured, job-ready course that builds the practical skills of a remote Sales Development Rep: prospecting and outreach, discovery, objection handling, and pipeline management, taking you from beginner to hireable. Eight modules, each packed with 10 to 16 videos, so every skill is broken down and demonstrated step by step. Where the blueprint maps the path, this course walks you through it.</p>
          <ul class="mx-auto mt-7 grid max-w-xl gap-x-8 gap-y-3 text-left sm:grid-cols-2">
            {courseIncludes.map((f) => (
              <li class="flex items-start gap-2.5 text-[0.95rem] text-ink-soft">
                <svg class="mt-0.5 shrink-0 text-navy-600" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <div class="mt-9 flex justify-center">
            <EnrollButton course="remote-sdr-training" title="Remote SDR Training" ngn={60000} listNgn={80000} align="center" />
          </div>
          <p class="mt-4 text-sm text-ink-faint">Lifetime access. Instant access after payment: your login link arrives by email. <a href="/remote-sdr-training" class="font-semibold text-navy underline-offset-4 hover:underline">See the full course</a>.</p>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS (dark band) -->
    <section class="band-dark relative overflow-hidden">
      <BandTexture src="/assets/brand/bg-gold-streak.webp" mirror={false} opacity={0.28} />
      <div class="relative z-[1] mx-auto max-w-7xl 2xl:max-w-[100rem] px-6 py-16 lg:py-24">
        <div class="max-w-2xl" data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-brass-soft">How it works</p>
          <h2 class="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-white sm:text-4xl">Skill-building, not shelf-ware.</h2>
        </div>
        <div class="mt-10">
          {steps.map((s) => (
            <div class="grid grid-cols-[auto_1fr] items-start gap-x-8 gap-y-1 border-t border-white/10 py-8 sm:grid-cols-[auto_1fr_auto]" data-reveal>
              <span class="font-serif text-2xl font-medium leading-none text-brass-soft sm:text-3xl">{s.i}</span>
              <div class="max-w-[54ch]"><h3 class="font-serif text-xl font-medium text-white">{s.h}</h3><p class="mt-2 text-white/70">{s.d}</p></div>
              <span class="hidden font-sans text-[0.7rem] font-semibold uppercase tracking-widest text-white/40 sm:block">{s.a}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-7xl 2xl:max-w-[100rem] px-6 py-16 lg:py-20">
        <div class="band-dark relative overflow-hidden rounded-2xl px-8 py-16 text-center ring-1 ring-white/10 sm:px-14 lg:py-20" data-reveal>
          <img src="/assets/brand/bg-staircase-dark.webp" alt="" aria-hidden="true" loading="lazy" class="pointer-events-none absolute inset-0 h-full w-full object-cover" style="opacity:.55;object-position:center right" />
          <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(135% 145% at 42% 55%, rgba(14,28,46,0.9) 0%, rgba(14,28,46,0.6) 52%, rgba(14,28,46,0.28) 100%)"></div>
          <div class="relative z-[1]">
            <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-brass-soft">Start building</p>
            <h2 class="mx-auto mt-3 max-w-lg font-serif text-3xl font-medium leading-tight tracking-tight text-white sm:text-4xl">The skill pays for itself. Let's begin.</h2>
            <p class="mx-auto mt-4 max-w-xl text-white/75">Tell us your goal and your timeline. We'll tell you honestly whether we can help, and how.</p>
            <a href="/contact" class="mt-8 inline-flex items-center gap-2 rounded-sm bg-white px-7 py-3.5 font-sans text-sm font-semibold text-navy shadow-lg shadow-black/20 transition hover:bg-ivory-deep">Book a call <span>&rarr;</span></a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
