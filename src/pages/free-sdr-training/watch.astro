---
// The pre-recorded free SDR training, shown after the /free-sdr-training opt-in. The
// bootcamp pitch is trimmed off the end of the recording; the pitch for the ₦60k course
// lives here on the page (and in the follow-up sequence) instead.
//
// TODO (Levi): upload the TRIMMED training to Bunny and paste its GUID into `trainingId`.
// If it goes in a library other than 776834, update TRAINING_LIBRARY too. While trainingId
// is empty the page shows a placeholder so the layout is previewable.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const TRAINING_LIBRARY = '795716';
const trainingId = 'aead0fee-f617-4b67-97e7-a85f274709c3'; // trimmed training (Bunny)
const trainingSrc = trainingId
  ? `https://iframe.mediadelivery.net/embed/${TRAINING_LIBRARY}/${trainingId}?preload=true&responsive=true`
  : '';

// The free-vs-course comparison shown under the video.
const freePoints = [
  'See what is possible',
  'How the work pays',
  'The path, start to finish',
  'Watch once, no cost',
];
const coursePoints = [
  'Master the real skills',
  'Coaching that keeps you moving',
  'Get hired, step by step',
  'Support the whole way',
];
---

<Base
  title="Your free SDR training | Levi Henry"
  description="The remote SDR free training."
  noindex={true}
>
  <Header minimal />

  <main id="main">
    <section class="mx-auto max-w-4xl px-6 py-14 lg:py-20">
      <div class="text-center">
        <p data-reveal class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">
          Your free SDR training
        </p>
        <h1
          data-reveal
          class="mt-4 font-serif text-3xl font-medium leading-[1.1] tracking-tight text-navy sm:text-4xl"
        >
          Watch this before you do anything else
        </h1>
        <p data-reveal class="mx-auto mt-4 max-w-xl text-ink-soft">
          Give it your full attention, start to finish. Everything you need to understand the
          opportunity is in here.
        </p>
      </div>

      <div data-reveal class="mt-8 overflow-hidden rounded-lg border border-line bg-navy shadow-lg">
        {trainingSrc ? (
          <div style="position:relative;padding-top:56.25%;">
            <iframe
              data-training-iframe
              src={trainingSrc}
              loading="lazy"
              style="position:absolute;inset:0;width:100%;height:100%;border:0;"
              allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;"
              allowfullscreen
              title="Remote SDR free training"></iframe>
          </div>
        ) : (
          <div
            style="position:relative;padding-top:56.25%;"
            class="flex items-center justify-center"
          >
            <p
              style="position:absolute;inset:0;"
              class="flex items-center justify-center px-6 text-center font-sans text-sm text-white/70"
            >
              Training video loads here. Paste the trimmed recording's Bunny GUID into
              <code class="mx-1 rounded bg-white/10 px-1">trainingId</code> to go live.
            </p>
          </div>
        )}
      </div>

      <div data-course-cta class="course-cta mx-auto mt-14 max-w-3xl">
        <!-- Express lane: experienced or ready people can go straight to the course -->
        <div class="mx-auto mb-10 max-w-2xl rounded-xl border border-line bg-paper-raised px-5 py-4 text-center">
          <p class="text-sm leading-relaxed text-ink-soft">
            Already have some sales experience, or seen enough and ready to go deeper? You do not have to
            finish the whole training first.
          </p>
          <a
            href="/remote-sdr-training"
            class="mt-2.5 inline-flex items-center gap-1.5 font-sans text-sm font-semibold text-navy underline underline-offset-4 hover:text-navy-600"
            >Skip straight to the full course <span aria-hidden="true">&rarr;</span></a
          >
        </div>

        <div class="text-center">
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">
            If you want more than the training
          </p>
          <h2 class="mt-3 font-serif text-2xl font-medium leading-tight text-navy sm:text-3xl">
            Where the free training ends, the course begins
          </h2>
        </div>

        <div class="mt-8 grid items-stretch gap-4 sm:grid-cols-[1fr_auto_1fr] sm:gap-3">
          <!-- Free training -->
          <div class="rounded-xl border border-line bg-paper-raised p-6 shadow-sm shadow-navy/5">
            <p class="font-sans text-xs font-bold uppercase tracking-[0.16em] text-navy-600">
              Free · 1 hr 20 min
            </p>
            <h3 class="mt-1.5 font-serif text-xl font-medium text-navy">Free SDR training</h3>
            <p class="mt-1.5 text-sm text-ink-soft">What you just watched. See the opportunity for yourself.</p>
            <ul class="mt-4 space-y-2.5">
              {freePoints.map((p) => (
                <li class="flex items-start gap-2.5 text-sm text-ink">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-navy-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Progression arrow: points right on desktop, down on mobile -->
          <div class="flex items-center justify-center py-1 text-navy-600" aria-hidden="true">
            <svg class="h-6 w-6 rotate-90 sm:rotate-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12" /><polyline points="13 5 20 12 13 19" /></svg>
          </div>

          <!-- Full course -->
          <div class="rounded-xl bg-navy p-6 text-white shadow-lg shadow-navy/20">
            <p class="font-sans text-xs font-bold uppercase tracking-[0.16em] text-white/70">
              ₦60,000 founding price
            </p>
            <h3 class="mt-1.5 font-serif text-xl font-medium text-white">Full Remote SDR Training</h3>
            <p class="mt-1.5 text-sm text-white/80">Where you go to build the skill and go after the job.</p>
            <ul class="mt-4 space-y-2.5">
              {coursePoints.map((p) => (
                <li class="flex items-start gap-2.5 text-sm text-white/90">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-white/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-8 text-center">
          <a
            href="/remote-sdr-training"
            class="btn-primary inline-flex items-center gap-2 rounded-sm px-7 py-3.5 font-sans text-sm font-semibold text-white"
            >See the full course <span aria-hidden="true">&rarr;</span></a
          >
          <p class="mt-3 text-sm text-ink-faint">Founding price while the first 100 seats last.</p>
        </div>

        <!-- Direct WhatsApp line, made obvious: the personal line people value -->
        <div
          class="mx-auto mt-10 max-w-2xl rounded-2xl p-6 shadow-lg shadow-navy/10 sm:p-7"
          style="background-color:#f1fbf5;border:1px solid #cfead9"
        >
          <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-5">
            <span
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full shadow-sm"
              style="background-color:#25D366"
            >
              <svg width="26" height="26" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </span>
            <div class="flex-1">
              <h2 class="font-serif text-xl font-medium leading-tight text-navy">
                Have a question? Message me directly
              </h2>
              <p class="mt-1.5 text-[0.95rem] leading-relaxed text-ink-soft">
                This is my own WhatsApp, and I read every message myself. Whatever is on your mind, a
                question, a doubt, or where you are starting from, send it over. Everyone I have spoken
                with this way has told me the direct line genuinely helped.
              </p>
            </div>
          </div>
          <a
            href="https://wa.link/r7l4s5"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-sm px-7 py-3.5 font-sans text-sm font-semibold text-white transition hover:brightness-110 sm:w-auto"
            style="background-color:#128C7E"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Message me on WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* The course CTA is visible by default. JS tucks it away with .is-pending and
     reveals it a bit after the training starts playing. If JS never runs, the CTA
     simply stays visible (no JS-dependent opacity:0 that could hide it for good). */
  .course-cta {
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .course-cta.is-pending {
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
  }
</style>

<script is:inline>
  (function () {
    var cta = document.querySelector('[data-course-cta]');
    if (!cta) return;

    var revealed = false;
    function reveal() {
      if (revealed) return;
      revealed = true;
      cta.classList.remove('is-pending');
    }

    try {
      // Schedule the guaranteed reveal BEFORE hiding, so the CTA always comes back
      // even if nothing below runs. Then tuck it away.
      var fallback = setTimeout(reveal, 90000);
      cta.classList.add('is-pending');

      // Bunny Stream speaks the player.js protocol over postMessage. Ask it to tell
      // us when playback starts, then reveal the next step a short while after.
      var iframe = document.querySelector('[data-training-iframe]');
      if (iframe && iframe.contentWindow) {
        var started = false;
        var subscribe = function () {
          try {
            ['play', 'timeupdate'].forEach(function (evt) {
              iframe.contentWindow.postMessage(
                JSON.stringify({
                  context: 'player.js',
                  version: '0.0.4',
                  method: 'addEventListener',
                  value: evt,
                  listener: evt,
                }),
                '*'
              );
            });
          } catch (e) {}
        };

        window.addEventListener('message', function (e) {
          var d = e.data;
          if (typeof d === 'string') {
            try {
              d = JSON.parse(d);
            } catch (x) {
              return;
            }
          }
          if (!d || d.context !== 'player.js') return;
          if (d.event === 'ready') subscribe();
          if ((d.event === 'play' || d.event === 'timeupdate') && !started) {
            started = true;
            clearTimeout(fallback);
            setTimeout(reveal, 30000);
          }
        });

        iframe.addEventListener('load', subscribe);
        subscribe();
      }
    } catch (e) {
      // Any failure: show the CTA rather than risk hiding it.
      reveal();
    }
  })();
</script>
