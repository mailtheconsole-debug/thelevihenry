---
// The VSL hub: the destination after the /free-sdr-training opt-in. Leads with the
// VSL (the short, proven closer), then a reveal-gated decision block that ranks the
// three next steps by commitment:
//   1. Enroll now (primary, buys in place via Paystack)
//   2. See everything inside the course (the full sales page)
//   3. Watch the full training first (the quiet soft-exit for the unsure)
// The full ~1 hr 20 min training lives at /free-sdr-training/full-training.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EnrollButton from '../../components/EnrollButton.astro';

// VSL hero video (its own Bunny Stream library, 795716, with controls stripped).
const VSL_LIBRARY = '795716';
const vslId = '3eb4eefc-9364-4fc8-9231-f9fb36febcc5';
---

<Base
  title="Your free SDR training | Levi Henry"
  description="The remote SDR free training."
  noindex={true}
>
  <Header minimal />

  <main id="main">
    <section class="mx-auto max-w-4xl px-6 py-14 lg:py-20">
      <div class="text-center">
        <p data-reveal class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">
          Your free SDR training
        </p>
        <h1
          data-reveal
          class="mt-4 font-serif text-3xl font-medium leading-[1.1] tracking-tight text-navy sm:text-4xl"
        >
          Start here. Watch this first.
        </h1>
        <p data-reveal class="mx-auto mt-4 max-w-xl text-ink-soft">
          A short walk-through of how Nigerians are getting hired for these remote roles. Watch it, then
          pick your next step below. The full training is there too if you want to go deeper.
        </p>
      </div>

      <!-- The VSL: muted autoplay facade, tap for sound -->
      <div data-reveal class="mx-auto mt-8 max-w-3xl">
        <div
          class="relative overflow-hidden rounded-2xl bg-navy-deep shadow-xl shadow-navy/25 ring-2 ring-beacon/40"
          style="aspect-ratio:16/9"
        >
          <img
            src="/assets/video/vsl-cover.webp"
            alt=""
            aria-hidden="true"
            width="1600"
            height="900"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <div id="vsl-frame" data-vsl-id={vslId} class="absolute inset-0 z-10"></div>
          <button
            type="button"
            id="vsl-sound"
            aria-label="Tap for sound"
            class="group absolute inset-0 z-20 flex cursor-pointer flex-col items-center justify-center transition-opacity duration-300"
          >
            <span class="absolute inset-0" style="background:radial-gradient(120% 90% at 50% 42%, rgba(8,21,36,0.22) 0%, rgba(8,21,36,0.46) 70%, rgba(8,21,36,0.70) 100%)"></span>
            <span class="pointer-events-none absolute left-1/2 top-1/2 h-[84px] w-[84px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-beacon/40 motion-safe:animate-ping"></span>
            <span class="relative flex h-[84px] w-[84px] items-center justify-center rounded-full bg-beacon shadow-xl shadow-beacon/30 transition-transform duration-200 group-hover:scale-110">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-navy-deep" aria-hidden="true">
                <path d="M11 5 6 9H2v6h4l5 4z" fill="currentColor" stroke="none" />
                <line x1="23" y1="9" x2="17" y2="15" />
                <line x1="17" y1="9" x2="23" y2="15" />
              </svg>
            </span>
            <span class="relative mt-5 font-sans text-base font-extrabold uppercase tracking-[0.12em] text-white sm:text-lg">Tap for sound</span>
            <span class="relative mt-1 font-sans text-xs font-semibold uppercase tracking-[0.18em] text-white/75">Your video has started</span>
          </button>
        </div>
      </div>

      <!-- Decision block: reveals a short while after the video starts -->
      <div data-decision class="decision mx-auto mt-14 max-w-3xl">
        <div class="text-center">
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">
            Your next step
          </p>
          <h2 class="mt-3 font-serif text-2xl font-medium leading-tight text-navy sm:text-3xl">
            Where you go from here
          </h2>
        </div>

        <!-- Primary: enroll in the full course, right here -->
        <div class="mx-auto mt-8 max-w-xl rounded-2xl border border-line bg-paper-raised p-6 text-center shadow-sm shadow-navy/5 sm:p-8">
          <p class="text-lg leading-relaxed text-ink-soft">
            Ready to build the skill and go after the job? Join the full Remote SDR Training.
          </p>
          <div class="mt-6 flex justify-center">
            <EnrollButton course="remote-sdr-training" title="Remote SDR Training" ngn={60000} listNgn={100000} align="center" />
          </div>
        </div>

        <!-- Secondary: read the full sales page first -->
        <div class="mt-8 text-center">
          <a
            href="/remote-sdr-training"
            data-cta="ClickSeeCourse"
            class="inline-flex items-center gap-2 rounded-sm border border-navy px-7 py-3.5 font-sans text-sm font-semibold text-navy transition hover:bg-navy hover:text-white"
            >See everything inside the course <span aria-hidden="true">&rarr;</span></a
          >
        </div>

        <!-- Soft exit: the quiet option for anyone not ready to decide -->
        <div class="mt-8 text-center">
          <a
            href="/free-sdr-training/full-training"
            data-cta="ClickFullTraining"
            class="font-sans text-sm text-ink-soft underline underline-offset-4 hover:text-navy"
            >Not ready to decide? Watch the full free training first <span aria-hidden="true">&rarr;</span></a
          >
        </div>

        <!-- Direct WhatsApp line, made obvious: the personal line people value -->
        <div
          class="mx-auto mt-12 max-w-2xl rounded-2xl p-6 shadow-lg shadow-navy/10 sm:p-7"
          style="background-color:#f1fbf5;border:1px solid #cfead9"
        >
          <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-5">
            <span
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full shadow-sm"
              style="background-color:#25D366"
            >
              <svg width="26" height="26" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </span>
            <div class="flex-1">
              <h2 class="font-serif text-xl font-medium leading-tight text-navy">
                Not sure yet? Message me directly
              </h2>
              <p class="mt-1.5 text-[0.95rem] leading-relaxed text-ink-soft">
                This is my own WhatsApp, and I read every message myself. If you are weighing this up, or
                you are not sure it fits where you are starting from, tell me and I will be straight with
                you. Everyone I have spoken with this way has told me the direct line genuinely helped.
              </p>
            </div>
          </div>
          <a
            href="https://wa.link/r7l4s5"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-sm px-7 py-3.5 font-sans text-sm font-semibold text-white transition hover:brightness-110 sm:w-auto"
            style="background-color:#128C7E"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Message me on WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* The decision block is visible by default. JS tucks it away with .is-pending and
     reveals it a short while after the video starts. If JS never runs, it simply
     stays visible (no JS-dependent opacity:0 that could hide it for good). */
  .decision {
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .decision.is-pending {
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
  }
</style>

<script is:inline>
  (function () {
    var frame = document.getElementById('vsl-frame');
    var sound = document.getElementById('vsl-sound');
    var decision = document.querySelector('[data-decision]');
    var vslId = frame && frame.getAttribute('data-vsl-id');
    var LIB = '795716';

    // Fire a Meta Pixel custom event only where the pixel is loaded (production host).
    function track(name) {
      try {
        if (typeof window.fbq === 'function') {
          window.fbq('trackCustom', name, { content_name: 'Remote SDR Training VSL (hub)' });
        }
      } catch (e) {}
    }

    // Reveal the decision block. Guarded so it only ever runs once.
    var revealed = false;
    function reveal() {
      if (revealed) return;
      revealed = true;
      if (decision) decision.classList.remove('is-pending');
    }

    try {
      // Schedule the guaranteed reveal BEFORE hiding, so the block always comes back
      // even if nothing below runs. Then tuck it away.
      setTimeout(reveal, 75000);
      if (decision) decision.classList.add('is-pending');
    } catch (e) {
      reveal();
    }

    // Watch milestones, shared across the muted autoplay frame and the unmuted frame
    // so each fires once. Best-effort via player.js; silently does nothing otherwise.
    var fired = {};
    function mark(key, evt) {
      if (fired[key]) return;
      fired[key] = true;
      track(evt);
    }
    function attachTracking(iframe) {
      function init() {
        if (!window.playerjs || !iframe) return;
        try {
          var player = new window.playerjs.Player(iframe);
          player.on('ready', function () {
            player.on('timeupdate', function (d) {
              if (!d || !d.duration) return;
              var s = d.seconds;
              var pct = (s / d.duration) * 100;
              if (s >= 60) mark('t1', 'VSLReached1min');
              if (s >= 180) mark('t3', 'VSLReached3min');
              if (s >= 360) mark('t6', 'VSLReached6min');
              if (s >= 900) mark('t15', 'VSLReached15min');
              if (s >= 1800) mark('t30', 'VSLReached30min');
              if (pct >= 25) mark('p25', 'VSLWatched25');
              if (pct >= 50) mark('p50', 'VSLWatched50');
              if (pct >= 75) mark('p75', 'VSLWatched75');
            });
            player.on('ended', function () { mark('p100', 'VSLWatched100'); });
          });
        } catch (e) {}
      }
      if (window.playerjs) { init(); return; }
      var s = document.createElement('script');
      s.src = 'https://assets.mediadelivery.net/playerjs/player-0.1.0.min.js';
      s.onload = init;
      s.onerror = function () {};
      document.head.appendChild(s);
    }

    function makeFrame(muted) {
      var f = document.createElement('iframe');
      f.src = 'https://iframe.mediadelivery.net/embed/' + LIB + '/' + vslId + '?autoplay=true&muted=' + muted + '&preload=true';
      f.className = 'absolute inset-0 h-full w-full';
      f.title = 'Remote SDR Training';
      f.setAttribute('allow', 'accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen');
      f.setAttribute('allowfullscreen', '');
      return f;
    }

    if (frame && vslId) {
      // Autoplay muted on load. Track it so we catch silent watchers too.
      var muted = makeFrame('true');
      frame.appendChild(muted);
      attachTracking(muted);

      var engaged = false;
      var turnOnSound = function () {
        if (engaged) return;
        engaged = true;
        track('VSLPlay');
        var unmuted = makeFrame('false');
        frame.replaceChildren(unmuted);
        attachTracking(unmuted);
        // Engaged viewers: reveal the next step a short while after the tap.
        setTimeout(reveal, 30000);
        if (sound) {
          sound.style.opacity = '0';
          sound.style.pointerEvents = 'none';
          setTimeout(function () { sound.remove(); }, 320);
        }
      };
      if (sound) sound.addEventListener('click', turnOnSound);
    } else {
      // No video id: show the decision block rather than hide it.
      reveal();
    }

    // CTA click tracking (Enroll opens are already tracked by the button as
    // InitiateCheckout, so we only tag the two link CTAs here).
    document.querySelectorAll('[data-cta]').forEach(function (el) {
      el.addEventListener('click', function () { track(el.getAttribute('data-cta')); });
    });
  })();
</script>
