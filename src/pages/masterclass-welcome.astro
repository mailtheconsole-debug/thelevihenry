---
import Base from '../layouts/Base.astro';

// Post-payment "you're in" page for the Meta Ads Masterclass. The register flow
// redirects here on a successful Paystack payment and stashes the buyer's details in
// sessionStorage, so we personalise and fire a deduped Purchase without putting anything
// in the URL. noindex: not for search.
//
// TODO(Levi): set WHATSAPP_GROUP to the real attendee group invite before launch. That is
// the one link buyers need at checkout. The Google Meet link is optional here: leave
// MEET_LINK empty and it is delivered through the group + email before class; set it to a
// real Meet URL to show a direct "Open Google Meet" button on this page.
const WHATSAPP_GROUP = 'https://chat.whatsapp.com/Jp0sQRtuu6vCNvp8xIRa44';
const MEET_LINK = '';

// VIP-only extras, shown on this page only to buyers who bought the VIP tier (read from
// the checkout handoff). TODO(Levi): paste the real links when ready.
//   VIP_GROUP:   invite to the smaller VIP WhatsApp group.
//   VIP_BOOKING: your 1:1 booking link (Calendly, etc.) for the private 45-minute session.
// Leave either empty and the block tells the VIP you will send that link by email instead,
// so nothing ever shows a broken button.
const VIP_GROUP = 'https://chat.whatsapp.com/I62iZfsC05WJQUmICXYi6n?s=cl&p=i&iam=2';
const VIP_BOOKING = '';

const checklist: [string, string][] = [
  ['Add it to your calendar now', 'Saturday, November 28, 4:00 to 7:00 pm WAT. Block the full 3 hours. Set an alarm for 3:45 pm so you are in early.'],
  ['Get your laptop ready', 'Join on a laptop, not a phone. A phone can watch, but you cannot follow along and build with me.'],
  ['Have your Facebook login, a business Page, and a card', 'You need a Facebook account, a business Page (or we make one live), and a card that works for Meta payments.'],
  ['Watch for your reminders', 'I send reminders in the WhatsApp group and by email, plus the Google Meet link again on the day.'],
];
---

<Base
  title="You're registered | Meta Ads Masterclass"
  description="Your seat for the Meta Ads Masterclass is confirmed. Here's how to get ready for Saturday, November 28."
  noindex={true}
>
  <header class="sticky top-0 z-40 border-b border-line bg-ivory/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-7xl 2xl:max-w-[100rem] items-center justify-between gap-4 px-6 py-3.5">
      <a href="/" aria-label="Levi Henry Group home">
        <img src="/assets/brand/logo-horizontal.png" alt="Levi Henry Group" width="2232" height="955" class="h-8 w-auto sm:h-9" />
      </a>
      <span class="font-sans text-sm font-semibold text-navy-600">Meta Ads Masterclass</span>
    </div>
  </header>

  <main id="main">
    <!-- Confirmation -->
    <section class="relative overflow-hidden border-b border-line bg-paper">
      <div class="relative z-[1] mx-auto max-w-2xl px-6 py-16 text-center lg:py-20">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand/10 ring-1 ring-brand/30" data-reveal>
          <svg class="text-brand" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
        </span>
        <p class="mt-6 font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600" data-reveal>Payment confirmed</p>
        <h1 class="mt-3 font-serif text-[2.1rem] font-medium leading-[1.08] tracking-tight text-navy sm:text-4xl lg:text-5xl" data-reveal>You're in. See you Saturday.</h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft" data-reveal>Your seat for the <strong class="font-semibold text-navy">Meta Ads Masterclass</strong> is confirmed, <strong class="font-semibold text-navy" data-buyer-email>and a copy is on its way to your email</strong>.</p>
        <p class="mt-4 font-sans text-sm font-semibold text-navy" data-reveal>Saturday, November 28, 2026 · 4:00 to 7:00 pm WAT · Live on Google Meet</p>
      </div>
    </section>

    <!-- Join the WhatsApp group: the first thing to do -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto max-w-3xl px-6 py-12 lg:py-14">
        <div class="rounded-2xl p-6 shadow-lg shadow-navy/10 sm:p-8" style="background-color:#f1fbf5;border:1px solid #cfead9" data-reveal>
          <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-6">
            <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full shadow-sm" style="background-color:#25D366">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </span>
            <div class="flex-1">
              <p class="font-sans text-xs font-bold uppercase tracking-[0.2em]" style="color:#128C7E">Do this first</p>
              <h2 class="mt-1 font-serif text-2xl font-medium leading-tight tracking-tight text-navy">Join the attendee WhatsApp group</h2>
              <p class="mt-2 text-[0.97rem] leading-relaxed text-ink-soft">This is where your Google Meet link, reminders, the replay, and the prompt pack land. Tap below to join now so nothing passes you by.</p>
            </div>
          </div>
          <a href={WHATSAPP_GROUP} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-sm px-7 py-3.5 font-sans text-sm font-semibold text-white transition hover:brightness-110 sm:w-auto" style="background-color:#128C7E">
            Join the WhatsApp group
          </a>
        </div>

        <div class="mt-5 rounded-2xl border border-line bg-paper-raised p-6" data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">Your Google Meet link</p>
          {MEET_LINK ? (
            <Fragment>
              <p class="mt-2 text-[0.97rem] leading-relaxed text-ink-soft">Save this now. I also resend it in the group and by email on the day.</p>
              <a href={MEET_LINK} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 rounded-sm border-2 border-navy px-6 py-3 font-sans text-sm font-bold text-navy transition hover:bg-navy hover:text-white">
                Open Google Meet
              </a>
            </Fragment>
          ) : (
            <p class="mt-2 text-[0.97rem] leading-relaxed text-ink-soft">I post the Google Meet link in the WhatsApp group above and send it to your email before the class, then again on the day. Join the group so you have it.</p>
          )}
        </div>
      </div>
    </section>

    <!-- VIP extras: in the DOM for everyone, revealed by the script only for VIP buyers. -->
    <section data-vip-block hidden class="border-b border-line bg-paper">
      <div class="mx-auto max-w-3xl px-6 py-12 lg:py-14">
        <div class="rounded-2xl p-6 shadow-lg shadow-navy/10 sm:p-8" style="background-color:#fffaf0;border:1px solid #f1d9a8">
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em]" style="color:#b7791f">Your VIP extras</p>
          <h2 class="mt-1 font-serif text-2xl font-medium leading-tight tracking-tight text-navy">You went VIP. Here is what is extra for you.</h2>
          <p class="mt-2 text-[0.97rem] leading-relaxed text-ink-soft">On top of everything in the class, you get a private 45-minute 1:1 with me and a smaller VIP group. Set both up now.</p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-line bg-paper-raised p-5">
              <p class="font-serif text-lg font-medium text-navy">Your private 1:1</p>
              <p class="mt-1 text-[0.95rem] leading-relaxed text-ink-soft">A 45-minute session with me, held within 7 days of the class.</p>
              {VIP_BOOKING ? (
                <a href={VIP_BOOKING} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 rounded-sm px-6 py-3 font-sans text-sm font-semibold text-white transition hover:brightness-110" style="background-color:#b7791f">Book your 1:1</a>
              ) : (
                <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-faint">I send your private booking link to your email and in the VIP group. Watch for it.</p>
              )}
            </div>
            <div class="rounded-xl border border-line bg-paper-raised p-5">
              <p class="font-serif text-lg font-medium text-navy">Your VIP group</p>
              <p class="mt-1 text-[0.95rem] leading-relaxed text-ink-soft">A smaller group where I answer your questions directly, before and after class.</p>
              {VIP_GROUP ? (
                <a href={VIP_GROUP} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 rounded-sm px-6 py-3 font-sans text-sm font-semibold text-white transition hover:brightness-110" style="background-color:#b7791f">Join the VIP group</a>
              ) : (
                <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-faint">I send your VIP group invite to your email. Watch for it.</p>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Get ready -->
    <section class="border-b border-line">
      <div class="mx-auto max-w-3xl px-6 py-14 lg:py-16">
        <h2 class="font-serif text-2xl font-medium leading-tight tracking-tight text-navy sm:text-3xl" data-reveal>Get ready for the day</h2>
        <ol class="mt-8 space-y-px overflow-hidden rounded-xl border border-line">
          {checklist.map(([t, d], i) => (
            <li class="flex gap-4 border-t border-line bg-paper-raised px-5 py-5 first:border-t-0 sm:px-6">
              <span class="font-serif text-xl font-medium leading-none text-brand">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="font-serif text-lg font-medium text-navy">{t}</p>
                <p class="mt-1 text-[0.97rem] leading-relaxed text-ink-soft">{d}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="mt-6 text-[0.97rem] leading-relaxed text-ink-soft" data-reveal>Show up live and you keep the replay plus the Claude and ChatGPT prompt pack, sent in the group after class.</p>
      </div>
    </section>

    <!-- Help -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto max-w-3xl px-6 py-12 text-center lg:py-14">
        <p class="text-ink-soft" data-reveal>
          Any trouble joining the group or with your payment? Email
          <a href="mailto:levi@thelevihenry.com" class="font-semibold text-navy underline underline-offset-2">levi@thelevihenry.com</a>
          with the email you paid with and I will sort it out.
        </p>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/10 bg-ink-black text-white/60">
    <div class="mx-auto flex max-w-7xl 2xl:max-w-[100rem] flex-col items-center gap-3 px-6 py-8 text-center text-xs sm:flex-row sm:justify-between sm:text-left">
      <span>&copy; <span data-year></span> Levi Henry Group. All rights reserved.</span>
      <span class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1">
        <a href="/privacy" class="transition hover:text-white">Privacy</a>
        <a href="/terms" class="transition hover:text-white">Terms</a>
      </span>
    </div>
  </footer>

  <script is:inline>
    // Personalise the confirmation + fire the Meta Purchase event, from the handoff
    // stashed in sessionStorage by the register flow (never the URL). textContent only.
    // Fires only on a real purchase handoff, deduped by the Paystack reference.
    try {
      var raw = sessionStorage.getItem('lhg_masterclass');
      if (raw) {
        var d = JSON.parse(raw);
        if (d && d.email) {
          var el = document.querySelector('[data-buyer-email]');
          if (el) el.textContent = 'and a copy is on its way to ' + d.email;
        }
        if (d && d.tier === 'vip') {
          var vipBlock = document.querySelector('[data-vip-block]');
          if (vipBlock) vipBlock.hidden = false;
        }
        if (window.fbq && d && d.value) {
          window.fbq('track', 'Purchase', {
            value: d.value,
            currency: d.currency || 'NGN',
            content_name: 'Meta Ads Masterclass',
            content_ids: ['meta-ads-masterclass-' + (d.tier || 'regular')],
            content_type: 'product'
          }, d.reference ? { eventID: d.reference } : undefined);
        }
        sessionStorage.removeItem('lhg_masterclass');
      }
    } catch (e) {}
  </script>
</Base>
