---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Add each new program here. `href` is the program's own page (waitlist or enrollment).
const programs = [
  {
    name: 'Meta Ads Bootcamp',
    status: 'Waitlist open · First cohort',
    blurb: "Stop boosting posts and hoping they work. In five live sessions, you'll set up Meta Ads Manager properly, launch a real campaign for your business, and learn to read the numbers so you know exactly what to fix and what to scale.",
    facts: ['5 live sessions', '6 weeks', '10 spots', '₦100,000'],
    cta: 'Save my spot',
    href: '/meta-ads-bootcamp',
    bg: 'bg-[linear-gradient(160deg,#2f6fd6_0%,#1e3a8a_52%,#16296b_100%)]',
  },
  {
    name: 'Remote SDR Mastery Course',
    status: 'Opens October 18',
    blurb: "I started my sales career making cold calls as an SDR. This course teaches everything I learned on the way up: prospecting, discovery, objection handling, and managing a pipeline. You'll go from beginner to ready for remote SDR roles, one short video at a time.",
    facts: ['8 modules', '10 to 16 videos each', 'Self-paced', 'Beginner friendly', '₦60,000'],
    cta: 'Get notified on October 18',
    href: '/remote-sdr-course',
    bg: 'bg-[linear-gradient(160deg,#24466f_0%,#14273f_55%,#0e1c2e_100%)]',
  },
];
---

<Base
  title="Programs | Levi Henry Group"
  description="Live programs and courses from Levi Henry Group. See what's open and join the waitlist for the next cohort."
>
  <Header />

  <main id="main">
    <section class="mx-auto max-w-6xl px-6 py-14 lg:py-16">
      <div class="max-w-3xl">
        <p data-reveal class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">Programs</p>
        <h1 data-reveal class="mt-4 font-serif text-4xl font-medium leading-[1.07] tracking-tight text-navy sm:text-5xl">Fifteen years of teaching people to turn skill into income. Now in programs you can join.</h1>
        <p data-reveal class="mt-5 max-w-2xl text-lg text-ink-soft">Every program is built around doing the work while you learn it. You'll apply each lesson to your own business or career, so you finish with something working: a live ad campaign, a sales pipeline, a skill someone will pay you for.</p>
        <p data-reveal class="mt-3 max-w-2xl text-lg text-ink-soft">Join a waitlist to hear first when enrollment opens.</p>
      </div>
    </section>

    <section class="border-t border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-6 px-6 py-16 md:grid-cols-2 lg:py-20">
        {programs.map((p) => (
          <a href={p.href} data-reveal class:list={[p.bg, 'group relative flex min-h-[340px] flex-col overflow-hidden rounded-2xl p-7 text-white shadow-xl shadow-navy/20 ring-1 ring-white/10 sm:p-9', 'motion-safe:transition motion-safe:duration-[var(--dur-hover)] motion-safe:ease-[var(--ease-out)] motion-safe:hover:-translate-y-2 motion-safe:hover:shadow-2xl motion-safe:hover:shadow-navy/45 motion-safe:active:translate-y-0 motion-safe:active:duration-[var(--dur-press)]']}>
            <div class="beacon-glow opacity-70 motion-safe:transition-opacity motion-safe:duration-[var(--dur-hover)] group-hover:opacity-100"></div>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white/12 via-transparent to-black/15"></div>
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 -translate-x-full bg-[linear-gradient(115deg,transparent_32%,rgba(255,255,255,0.16)_50%,transparent_68%)] motion-safe:transition-transform motion-safe:duration-700 motion-safe:ease-[var(--ease-out)] motion-safe:group-hover:translate-x-full"></div>
            <p class="relative font-sans text-xs font-bold uppercase tracking-[0.2em] text-white/75">{p.status}</p>
            <h2 class="relative mt-3 font-serif text-2xl font-medium leading-tight sm:text-3xl">{p.name}</h2>
            <p class="relative mt-3 text-white/85">{p.blurb}</p>
            <ul class="relative mt-5 flex flex-wrap gap-2">
              {p.facts.map((f) => <li class="rounded-full border border-white/25 px-3 py-1 text-xs text-white/85 motion-safe:transition-colors motion-safe:duration-[var(--dur-hover)] group-hover:border-white/45 group-hover:bg-white/10">{f}</li>)}
            </ul>
            <div class="relative mt-auto pt-8">
              <span class="inline-flex items-center gap-2 border-b border-white/50 pb-0.5 font-sans text-sm font-semibold">
                {p.cta} <span class="motion-safe:transition-transform motion-safe:duration-300 group-hover:translate-x-1.5">&rarr;</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Base>
