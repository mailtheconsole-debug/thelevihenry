    aria-label="Questions? Chat with Levi on WhatsApp"
    class="fixed bottom-5 right-5 z-50 inline-flex items-center gap-2.5 rounded-full px-4 py-3 font-sans text-sm font-semibold text-white shadow-xl transition hover:brightness-110 sm:bottom-6 sm:right-6"
    style="background:#25D366"
  >
    <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.33 4.95L2 22l5.3-1.38a9.9 9.9 0 004.74 1.2h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0012.04 2zm5.8 14.04c-.24.68-1.42 1.3-1.95 1.34-.5.05-.96.24-3.23-.67-2.73-1.08-4.45-3.88-4.58-4.06-.13-.18-1.1-1.46-1.1-2.79 0-1.33.7-1.98.94-2.25.25-.27.54-.34.72-.34.18 0 .36 0 .52.01.17.01.39-.06.6.46.24.56.8 1.94.87 2.08.07.14.12.3.02.48-.09.18-.14.3-.27.46-.14.16-.29.36-.41.48-.14.14-.28.29-.12.56.16.27.72 1.19 1.55 1.93 1.06.95 1.96 1.24 2.23 1.38.27.14.43.12.6-.07.17-.18.69-.8.87-1.08.18-.27.37-.22.6-.13.24.09 1.5.71 1.76.84.27.14.44.2.5.31.07.11.07.63-.17 1.31z" /></svg>
    <span class="hidden sm:inline">Questions? Chat with me</span>
