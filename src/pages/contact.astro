---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const input = 'w-full rounded border border-line-strong bg-white px-3.5 py-2.5 text-ink transition focus:border-brass focus:outline-none focus:ring-2 focus:ring-brass/20';
const label = 'mb-1.5 block font-sans text-xs font-semibold uppercase tracking-wider text-ink-soft';
---

<Base
  title="Contact Us | Levi Henry Group"
  description="Tell us where you are and what you're trying to grow. We'll reply personally with the honest next step — or book a free 30-minute discovery call."
>
  <Header />

  <main id="main">
    <!-- HERO -->
    <section class="mx-auto max-w-6xl px-6 py-14 lg:py-16">
      <div class="max-w-3xl">
        <p data-reveal class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">Contact Us</p>
        <h1 data-reveal class="mt-4 font-serif text-4xl font-medium leading-[1.07] tracking-tight text-navy sm:text-5xl">Let's talk about what you're building.</h1>
        <p data-reveal class="mt-5 max-w-2xl text-lg text-ink-soft">Two easy ways to reach us: send a message and we'll reply personally, or book a free 30-minute discovery call with our team. Whichever you prefer.</p>
      </div>
    </section>

    <section class="border-t border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 lg:grid-cols-2 lg:py-20">
        <!-- OPTION 1 — MESSAGE -->
        <form method="POST" action="/.netlify/functions/contact" data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">Option 1 · Send a message</p>
          <h2 class="mt-3 font-serif text-2xl font-medium leading-tight text-navy sm:text-3xl">Send us a message</h2>
          <p class="mb-6 mt-2 text-ink-soft">Tell us where you are and what you're trying to build. We'll reply personally.</p>
          <p hidden><label>Leave this empty: <input name="bot-field" /></label></p>
          <div class="mb-4">
            <label class={label} for="name">Name</label>
            <input class={input} id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="mb-4">
            <label class={label} for="email">Email</label>
            <input class={input} id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="mb-4">
            <label class={label} for="about">Are you an individual or a business?</label>
            <input class={input} id="about" name="about" type="text" placeholder="Individual · Business · Not sure yet" />
          </div>
          <div class="mb-4">
            <label class={label} for="message">What are you trying to build?</label>
            <textarea class={`${input} min-h-[140px] resize-y`} id="message" name="message" required></textarea>
          </div>
          <button type="submit" class="group inline-flex items-center gap-2 btn-primary rounded-sm px-7 py-3.5 font-sans text-sm font-semibold text-white">
            Send message <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
          </button>
          <p data-form-status role="status" aria-live="polite" class="mt-4 text-sm italic text-ink-faint"></p>
        </form>

        <!-- OPTION 2 — DISCOVERY CALL -->
        <aside data-reveal>
          <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">Option 2 · Book a call</p>
          <h2 class="mt-3 font-serif text-2xl font-medium leading-tight text-navy sm:text-3xl">Book a free discovery call</h2>
          <p class="mt-2 text-ink-soft">Grab 30 minutes with our team to talk through where you are and what's next — no cost, no pressure.</p>
          <figure class="panel-brand group relative m-0 mt-6 aspect-[4/5] max-w-sm overflow-hidden rounded-2xl shadow-2xl shadow-navy/40 ring-1 ring-white/10">
            <div class="beacon-glow"></div>
            <img src="/assets/photos/levi-contact.webp" alt="Levi Henry, Levi Henry Group" width="750" height="1002" loading="lazy" class="absolute inset-0 z-[1] h-full w-full object-cover object-top transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out)] group-hover:scale-[1.03]" />
          </figure>
          <a href="/book-discovery" class="btn-primary mt-6 inline-flex items-center gap-2 rounded-sm px-7 py-3.5 font-sans text-sm font-semibold text-white">
            Book your free 30-min call <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
          </a>
          <p class="mt-5 text-sm text-ink-soft">Prefer email? Reach us at <a href="mailto:hello@thelevihenry.com" class="font-semibold text-navy underline decoration-navy/30 underline-offset-2 hover:decoration-navy">hello@thelevihenry.com</a></p>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Base>
