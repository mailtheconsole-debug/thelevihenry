---
// The pre-recorded free training, shown after the /free-training opt-in. The bootcamp
// pitch is trimmed off the end of the recording; the pitch for the ₦60k course lives
// here on the page (and in the follow-up sequence) instead.
//
// TODO (Levi): upload the TRIMMED training to Bunny and paste its GUID into `trainingId`.
// If it goes in a library other than 776834, update TRAINING_LIBRARY too. While trainingId
// is empty the page shows a placeholder so the layout is previewable.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const TRAINING_LIBRARY = '776834';
const trainingId = ''; // <-- paste the trimmed training's Bunny GUID here
const trainingSrc = trainingId
  ? `https://iframe.mediadelivery.net/embed/${TRAINING_LIBRARY}/${trainingId}?preload=true&responsive=true`
  : '';
---

<Base
  title="Your free training | Levi Henry"
  description="The remote SDR free training."
  noindex={true}
>
  <Header />

  <main id="main">
    <section class="mx-auto max-w-4xl px-6 py-14 lg:py-20">
      <div class="text-center">
        <p data-reveal class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">
          Your free training
        </p>
        <h1
          data-reveal
          class="mt-4 font-serif text-3xl font-medium leading-[1.1] tracking-tight text-navy sm:text-4xl"
        >
          Watch this before you do anything else
        </h1>
        <p data-reveal class="mx-auto mt-4 max-w-xl text-ink-soft">
          Give it your full attention, start to finish. Everything you need to understand the
          opportunity is in here.
        </p>
      </div>

      <div data-reveal class="mt-8 overflow-hidden rounded-lg border border-line bg-navy shadow-lg">
        {trainingSrc ? (
          <div style="position:relative;padding-top:56.25%;">
            <iframe
              src={trainingSrc}
              loading="lazy"
              style="position:absolute;inset:0;width:100%;height:100%;border:0;"
              allow="accelerometer;gyroscope;autoplay;encrypted-media;picture-in-picture;"
              allowfullscreen
              title="Remote SDR free training"></iframe>
          </div>
        ) : (
          <div
            style="position:relative;padding-top:56.25%;"
            class="flex items-center justify-center"
          >
            <p
              style="position:absolute;inset:0;"
              class="flex items-center justify-center px-6 text-center font-sans text-sm text-white/70"
            >
              Training video loads here. Paste the trimmed recording's Bunny GUID into
              <code class="mx-1 rounded bg-white/10 px-1">trainingId</code> to go live.
            </p>
          </div>
        )}
      </div>

      <div
        data-reveal
        class="mx-auto mt-12 max-w-2xl rounded-lg border border-line bg-paper p-8 text-center"
      >
        <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">
          Ready to go further
        </p>
        <h2 class="mt-3 font-serif text-2xl font-medium leading-tight text-navy sm:text-3xl">
          The full Remote SDR Training takes you from watching to hired
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-ink-soft">
          The training showed you the path. The course walks you down it, step by step, with the
          scripts, the system and the coaching to get you into a remote role and paid in foreign
          currency. Founding price for the first 100 students.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <a
            href="/remote-sdr-training"
            class="btn-primary inline-flex items-center gap-2 rounded-sm px-7 py-3.5 font-sans text-sm font-semibold text-white"
            >See the full course <span aria-hidden="true">&rarr;</span></a
          >
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
