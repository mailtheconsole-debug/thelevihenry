const mentorship = [
  { label: 'Nanmwa\'s personalized LinkedIn outreach got a reply from a Head of Sales', quote: 'Appreciate the relevant and personalized outreach… How can I help you?', img: 'nanmwa-head-of-sales-reply' },
  { label: 'Nanmwa\'s cold email booked a meeting', quote: 'Thank you for reaching out! Tuesday at 1pm works for me.', img: 'nanmwa-meeting-booked' },
  { label: 'Nanmwa practicing discovery', quote: 'I ran a discovery with an old friend today and I got him talking stuff that he didn\'t ever talk about before now.', img: 'nanmwa-discovery-practice' },
