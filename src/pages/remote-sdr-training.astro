const stack = [
  ['Remote SDR Training: 8 modules, 116 lessons, 18 hours, lifetime access', '₦80,000'],
  ['RepActs Log daily tracker, RepActs CRM job-hunt pipeline, CV and LinkedIn builder, quizzes, leaderboard', '₦150,000'],
  ['Bonus: The Swipe Pack: 48 proven openers, objection handlers, and closes', '₦40,000'],
  ['Bonus: a real 84-minute one-on-one coaching session, recorded', '₦50,000'],
  ['Bonus: The Remote SDR Career Blueprint (book)', '₦10,000'],
  ['Bonus: Interview Answers Decoded', '₦10,000'],
