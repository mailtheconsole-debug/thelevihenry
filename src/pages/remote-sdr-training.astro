const benefits = [
  ['You stop waiting to be picked.', 'You\'ll know how to put yourself in front of the person who decides, any day you choose.'],
  ['You walk into interviews already ahead.', 'The hiring manager has seen your messages, heard your voice, and watched you do the job before you sit down.'],
  ['"Where are you based?" stops being a problem.', 'You\'ll have a clear, confident answer about working as an international contractor, with no visa, sponsorship, or US payroll needed on their side.'],
