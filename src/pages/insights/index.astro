---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('insights', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Insights | Levi Henry Group"
  description="Practical writing on sales, go-to-market, and building the systems that produce revenue — from Levi Henry Group."
>
  <Header />

  <main id="main">
    <!-- HERO -->
    <section class="mx-auto max-w-6xl px-6 py-14 lg:py-20">
      <div class="max-w-3xl">
        <p data-reveal class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">Insights</p>
        <h1 data-reveal class="mt-4 font-serif text-4xl font-medium leading-[1.07] tracking-tight text-navy sm:text-5xl">Notes on sales, GTM, and building revenue.</h1>
        <p data-reveal class="mt-5 max-w-2xl text-lg text-ink-soft">Practical writing on breaking into tech sales, taking a product to market, and building the systems that turn effort into revenue. No fluff.</p>
      </div>
    </section>

    <!-- POSTS -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
        {posts.length === 0 ? (
          <p class="text-ink-soft" data-reveal>New articles are on the way. Check back soon.</p>
        ) : (
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((p) => (
              <a
                href={`/insights/${p.id}`}
                class="group flex flex-col rounded-lg border border-line bg-paper-raised p-7 transition duration-300 hover:-translate-y-1 hover:border-navy-600/40 hover:shadow-xl hover:shadow-navy/10"
                data-reveal
              >
                <span class="font-sans text-xs font-semibold uppercase tracking-widest text-navy-600">{fmt(p.data.date)}</span>
                <h2 class="mt-3 font-serif text-xl font-medium leading-snug text-navy">{p.data.title}</h2>
                <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-ink-soft">{p.data.description}</p>
                <span class="mt-5 inline-flex items-center gap-2 font-sans text-sm font-semibold text-navy">
                  Read <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
                </span>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Base>
