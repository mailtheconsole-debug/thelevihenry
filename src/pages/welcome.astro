---
import Base from '../layouts/Base.astro';

// Post-purchase "you're in" page. The Enroll button redirects here on a
// successful Paystack payment (and stashes the buyer's email in sessionStorage
// so we can personalise without putting it in the URL). noindex: not for search.

// Drop a Bunny Stream video id here once the short welcome video is recorded and
// the embed + step appear automatically. Empty = no video block yet.
const welcomeVideoId = '5a92ddd5-f575-49f1-9104-f0f028955dac';
const embed = (id: string) => `https://iframe.mediadelivery.net/embed/776834/${id}?preload=false`;

const LOGIN = 'https://learn.thelevihenry.com/login';
const WHATSAPP_GROUP = 'https://chat.whatsapp.com/F6xAOZPA6UCBSLhoH8HGzr?mode=gi_t';

const steps: [string, string][] = [
  [
    'Check your email for your login link',
    'You\'ll get two emails within a minute or two. One is your login link: the email titled "Your LHG Academy login link", with a gold "Log in to the Academy" button that signs you straight in. The other welcomes you and carries the WhatsApp group link. Can\'t find them? Check spam and promotions. The login link works once and expires in 15 minutes, so use it soon.',
  ],
  [
    'Follow the welcome checklist on your Home page',
    'The link lands you on your Home page, and right at the top is a "Welcome to Remote SDR Training" checklist: join the WhatsApp group, read the Career Blueprint book, watch the course intro, set a password, and log your first day in RepActs. Start with the Blueprint, then work through the 8 modules, best done in order.',
  ],
  [
    'Do the work and get it reviewed',
    'The course works when you work it. Every assignment you submit, Levi reviews and sends back with feedback. Show up each week: the top student on the leaderboard that week wins a free one-hour session with me, and passing the final test earns you a verifiable certificate.',
  ],
];
---

<Base
  title="You're enrolled | Levi Henry Group"
  description="Welcome to LHG Academy — your enrollment is confirmed. Here's how to get started."
  noindex={true}
>
  <!-- Minimal header: logo + Student login only (no main nav) -->
  <header class="sticky top-0 z-40 border-b border-line bg-ivory/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-7xl 2xl:max-w-[100rem] items-center justify-between gap-4 px-6 py-3.5">
      <a href="/" aria-label="Levi Henry Group home">
        <img src="/assets/brand/logo-horizontal.png" alt="Levi Henry Group" width="2232" height="955" class="h-8 w-auto sm:h-9" />
      </a>
      <a href={LOGIN} class="font-sans text-sm font-semibold text-navy underline-offset-4 hover:underline">Student login</a>
    </div>
  </header>

  <main id="main">
    <!-- Confirmation -->
    <section class="hero-band relative overflow-hidden border-b border-line">
      <img src="/assets/brand/bg-hero-light.webp" alt="" aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-70" style="object-position:right center" />
      <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(70% 80% at 50% 40%, rgba(251,249,244,0.88), rgba(251,249,244,0.42) 55%, rgba(251,249,244,0.1) 100%)"></div>
      <div class="relative z-[1] mx-auto max-w-2xl px-6 py-16 text-center lg:py-20">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand/10 ring-1 ring-brand/30" data-reveal>
          <svg class="text-brand" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
        </span>
        <p class="mt-6 font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600" data-reveal>Payment confirmed</p>
        <h1 class="mt-3 font-serif text-[2.1rem] font-medium leading-[1.08] tracking-tight text-navy sm:text-4xl lg:text-5xl" data-reveal>You're in. Welcome to the Academy.</h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft" data-reveal>Your enrollment in <strong class="font-semibold text-navy">Remote SDR Training</strong> is confirmed, and <strong class="font-semibold text-navy" data-enrolled-email>your login link is on its way</strong>.</p>
        <div class="mt-8 flex justify-center" data-reveal>
          <a href={LOGIN} class="btn-primary inline-flex items-center gap-2 rounded-sm px-7 py-3.5 font-sans text-sm font-semibold text-white">Log in to the Academy <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </section>

    {welcomeVideoId && (
      <section class="border-t border-line bg-paper">
        <div class="mx-auto max-w-3xl px-6 py-14 lg:py-16">
          <div class="max-w-xl" data-reveal>
            <p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-600">Watch this first</p>
            <h2 class="mt-2 font-serif text-2xl font-medium leading-tight tracking-tight text-navy sm:text-3xl">A welcome from Levi, and how it all works</h2>
          </div>
          <div class="mt-7 overflow-hidden rounded-xl bg-navy-deep shadow-lg ring-1 ring-line" style="aspect-ratio:16/9" data-reveal>
            <iframe src={embed(welcomeVideoId)} loading="lazy" title="Welcome to Remote SDR Training" class="h-full w-full" allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
          </div>
        </div>
      </section>
    )}

    <!-- Join the WhatsApp group: prominent + on-screen (our most reliable channel for this audience) -->
    <section class="border-t border-line bg-paper">
      <div class="mx-auto max-w-3xl px-6 py-12 lg:py-14">
        <div class="rounded-2xl p-6 shadow-lg shadow-navy/10 sm:p-8" style="background-color:#f1fbf5;border:1px solid #cfead9" data-reveal>
          <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-6">
            <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full shadow-sm" style="background-color:#25D366">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </span>
            <div class="flex-1">
              <p class="font-sans text-xs font-bold uppercase tracking-[0.2em]" style="color:#128C7E">Stay in the loop</p>
              <h2 class="mt-1 font-serif text-2xl font-medium leading-tight tracking-tight text-navy">Join the student WhatsApp group</h2>
              <p class="mt-2 text-[0.97rem] leading-relaxed text-ink-soft">This is where we post updates, reminders, and the help you'll need — and where you meet the other students. Tap below to join so nothing passes you by.</p>
            </div>
          </div>
          <a href={WHATSAPP_GROUP} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-sm px-7 py-3.5 font-sans text-sm font-semibold text-white transition hover:brightness-110 sm:w-auto" style="background-color:#128C7E">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Join the WhatsApp group
          </a>
        </div>
      </div>
    </section>

    <!-- What happens next -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-3xl px-6 py-14 lg:py-16">
        <h2 class="font-serif text-2xl font-medium leading-tight tracking-tight text-navy sm:text-3xl" data-reveal>Here's what happens next</h2>
        <ol class="mt-8 space-y-px overflow-hidden rounded-xl border border-line">
          {steps.map(([t, d], i) => (
            <li class="flex gap-4 border-t border-line bg-paper-raised px-5 py-5 first:border-t-0 sm:px-6">
              <span class="font-serif text-xl font-medium leading-none text-brand">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="font-serif text-lg font-medium text-navy">{t}</p>
                <p class="mt-1 text-[0.97rem] leading-relaxed text-ink-soft">{d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Help -->
    <section class="border-t border-line bg-paper">
      <div class="mx-auto max-w-3xl px-6 py-12 text-center lg:py-14">
        <p class="text-ink-soft" data-reveal>
          No login email after 10 minutes? Go to the
          <a href={LOGIN} class="font-semibold text-navy underline underline-offset-2">login page</a>
          and tap "Email me a login link" with the email you paid with. Still nothing? Email
          <a href="mailto:levi@thelevihenry.com" class="font-semibold text-navy underline underline-offset-2">levi@thelevihenry.com</a>
          with your payment email, and we'll get you in.
        </p>
      </div>
    </section>
  </main>

  <!-- Minimal footer -->
  <footer class="border-t border-white/10 bg-ink-black text-white/60">
    <div class="mx-auto flex max-w-7xl 2xl:max-w-[100rem] flex-col items-center gap-3 px-6 py-8 text-center text-xs sm:flex-row sm:justify-between sm:text-left">
      <span>&copy; <span data-year></span> Levi Henry Group. All rights reserved.</span>
      <span class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1">
        <a href={LOGIN} class="transition hover:text-white">Student login</a>
        <a href="/privacy" class="transition hover:text-white">Privacy</a>
        <a href="/terms" class="transition hover:text-white">Terms</a>
      </span>
    </div>
  </footer>

  <script is:inline>
    // Personalise the confirmation + fire the Meta Purchase event, from the
    // handoff stashed in sessionStorage by the Enroll button (never the URL).
    // textContent only — no injection. Fires only on a real purchase handoff.
    try {
      var raw = sessionStorage.getItem('lhg_enrolled');
      if (raw) {
        var d = JSON.parse(raw);
        if (d && d.email) {
          var el = document.querySelector('[data-enrolled-email]');
          if (el) el.textContent = 'your login link is on its way to ' + d.email;
        }
        if (window.fbq && d && d.value) {
          window.fbq('track', 'Purchase', {
            value: d.value,
            currency: d.currency || 'NGN',
            content_name: d.title || 'Remote SDR Training',
            content_ids: [d.course || 'remote-sdr-training'],
            content_type: 'product'
          }, d.reference ? { eventID: d.reference } : undefined);
        }
        sessionStorage.removeItem('lhg_enrolled');
      }
    } catch (e) {}
  </script>
</Base>
